<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Default builds offline with zero external NuGet dependencies using native Win32/COM/WPF. -->
    <!-- Pass -p:FullSdk=true when NuGet access is available to enable CsWinRT + ONNX Runtime packages. -->
    <FullSdk Condition="'$(FullSdk)'==''">false</FullSdk>
    <TargetFramework Condition="'$(FullSdk)'!='true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(FullSdk)'=='true'">net8.0-windows10.0.19041.0</TargetFramework>
    <DefineConstants Condition="'$(FullSdk)'=='true'">$(DefineConstants);WITH_WINRT;WITH_ONNX</DefineConstants>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>PulseIsland</AssemblyName>
    <RootNamespace>PulseIsland</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>PulseIsland</Authors>
    <ApplicationIcon>..\..\assets\PulseIsland.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prevent WinForms implicit global usings from colliding with WPF types (Color, Brush, Point, Application) -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PulseIsland.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(FullSdk)'=='true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="1.0.2" />
  </ItemGroup>

</Project>
