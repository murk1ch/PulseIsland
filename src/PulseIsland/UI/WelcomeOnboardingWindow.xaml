<Window x:Class="PulseIsland.UI.WelcomeOnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_Onboard_WindowTitle}"
        Width="560"
        Height="516"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Loaded="OnWindowLoaded"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Geometry x:Key="CloseIconGeometry">M 1,1 L 10,10 M 10,1 L 1,10</Geometry>
        <Geometry x:Key="SparkleGeometry">M 6,0.5 L 7.4,4.6 L 11.5,6 L 7.4,7.4 L 6,11.5 L 4.6,7.4 L 0.5,6 L 4.6,4.6 Z</Geometry>
        <Geometry x:Key="ScanFrameGeometry">M 1,4 L 1,1 L 4,1 M 8,1 L 11,1 L 11,4 M 11,8 L 11,11 L 8,11 M 4,11 L 1,11 L 1,8 M 4,6 L 8,6 M 6,4 L 6,8</Geometry>
        <Geometry x:Key="MicMiniGeometry">M 4.5,1 A 1.5,1.5 0 0 1 7.5,1 L 7.5,5.5 A 1.5,1.5 0 0 1 4.5,5.5 Z M 2.5,5 A 3.5,3.5 0 0 0 9.5,5 M 6,8.5 L 6,11 M 4,11 L 8,11</Geometry>
        <Geometry x:Key="CheckMarkGeometry">M 1.5,6 L 4.5,9 L 10.5,2.5</Geometry>

        <Style x:Key="GlassBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeButtonHoverBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeButtonPressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccentGradientBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.80" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ChkBox"
                                    Grid.Column="0"
                                    Width="18" Height="18"
                                    CornerRadius="5"
                                    Background="{DynamicResource ThemeControlBgBrush}"
                                    BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,1,9,0"
                                    VerticalAlignment="Top">
                                <Path x:Name="ChkMark"
                                      Data="{StaticResource CheckMarkGeometry}"
                                      Stroke="{DynamicResource ThemeAccentTextBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="10" Height="9"
                                      Stretch="Uniform"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChkBox" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="ChkBox" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="ChkMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChkBox" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="18" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="0.93" ScaleY="0.93" />
        </Grid.RenderTransform>
        <Grid.Effect>
            <BlurEffect x:Name="CardBlur" Radius="8" />
        </Grid.Effect>

        <Border x:Name="MainCard"
                CornerRadius="26"
                BorderThickness="1"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeGlassBorderBrush}">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="24" ShadowDepth="6" Opacity="0.65" />
            </Border.Effect>

            <Grid>
                <Border CornerRadius="25,25,80,80"
                        Height="64"
                        VerticalAlignment="Top"
                        Background="{DynamicResource ThemeReflectionBrush}"
                        IsHitTestVisible="False" />

                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28"
                                    CornerRadius="9"
                                    Background="{DynamicResource ThemeHighlightBrush}"
                                    BorderBrush="{DynamicResource ThemeAccentBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,10,0">
                                <Path Data="{StaticResource SparkleGeometry}"
                                      Fill="{DynamicResource ThemeAccentBrush}"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PulseIsland"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           FontSize="17"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="StepSubtitleText"
                                           Text="Step 1 of 3 • Language &amp; Appearance"
                                           Foreground="{DynamicResource ThemeSectionHeaderBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                Click="OnSkipOrCloseClick"
                                Style="{StaticResource GlassBtnStyle}"
                                Width="30" Height="28"
                                Padding="0"
                                ToolTip="{DynamicResource Loc_Onboard_SkipTooltip}">
                            <Path Data="{StaticResource CloseIconGeometry}"
                                  Stroke="{DynamicResource ThemeTextPrimaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="9" Height="9"
                                  Stretch="Uniform" />
                        </Button>
                    </DockPanel>

                    <!-- Content Area -->
                    <Grid x:Name="StepBodyContainer" Grid.Row="1">
                        <!-- STEP 1: Language, Theme & Glass -->
                        <StackPanel x:Name="Step1Panel">
                            <TextBlock Text="{DynamicResource Loc_Onboard_Step1Title}"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource Loc_Onboard_Step1Desc}"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />

                            <!-- Sleek Compact Interface Language Pill Selector -->
                            <Border Background="{DynamicResource ThemeCardBgBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="12,8"
                                    Margin="0,0,0,12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{DynamicResource Loc_Field_UiLanguage}"
                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button x:Name="LangEnBtn"
                                                Content="English"
                                                Tag="en"
                                                Click="OnLanguageChoiceClick"
                                                Style="{StaticResource GlassBtnStyle}"
                                                Padding="13,5"
                                                FontSize="11.5"
                                                Margin="0,0,6,0" />
                                        <Button x:Name="LangRuBtn"
                                                Content="Русский"
                                                Tag="ru"
                                                Click="OnLanguageChoiceClick"
                                                Style="{StaticResource GlassBtnStyle}"
                                                Padding="13,5"
                                                FontSize="11.5" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <WrapPanel x:Name="ThemesWrapPanel" Margin="0,0,0,10" />

                            <Border Background="{DynamicResource ThemeCardBgBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14,10">
                                <CheckBox x:Name="DwmBlurCheck"
                                          Margin="0"
                                          Checked="OnDwmBlurToggled"
                                          Unchecked="OnDwmBlurToggled"
                                          Content="{DynamicResource Loc_Onboard_DwmBlur}" />
                            </Border>
                        </StackPanel>

                        <!-- STEP 2: Alt+Q, Vision & Voice Guide -->
                        <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Loc_Onboard_Step2Title}"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />

                            <Border Background="{DynamicResource ThemeCardBgBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="13,10"
                                    Margin="0,0,0,9">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left"
                                            Background="{DynamicResource ThemeHighlightBrush}"
                                            BorderBrush="{DynamicResource ThemeAccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="9,6"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc_Onboard_Step2Key1}"
                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc_Onboard_Step2Card1Title}"
                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Loc_Onboard_Step2Card1Desc}"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeCardBgBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="13,10"
                                    Margin="0,0,0,9">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left"
                                            Background="{DynamicResource ThemeHighlightBrush}"
                                            BorderBrush="{DynamicResource ThemeAccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="9,6"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc_Onboard_Step2Key2}"
                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc_Onboard_Step2Card2Title}"
                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Loc_Onboard_Step2Card2Desc}"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Background="{DynamicResource ThemeCardBgBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="13,10">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left"
                                            Width="34" Height="32"
                                            Background="{DynamicResource ThemeHighlightBrush}"
                                            BorderBrush="{DynamicResource ThemeAccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <Path Data="{StaticResource MicMiniGeometry}"
                                              Stroke="{DynamicResource ThemeAccentBrush}"
                                              StrokeThickness="1.4"
                                              Width="12" Height="12"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc_Onboard_Step2Card3Title}"
                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource Loc_Onboard_Step2Card3Desc}"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- STEP 3: Modules -->
                        <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Loc_Onboard_Step3Title}"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource Loc_Onboard_Step3Desc}"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />

                            <Border Background="{DynamicResource ThemeCardBgBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16,13">
                                <StackPanel>
                                    <CheckBox x:Name="ModMusicCheck" Content="{DynamicResource Loc_Onboard_ModMusic}" />
                                    <CheckBox x:Name="ModAudioLiveCheck" Content="{DynamicResource Loc_Onboard_ModAudioLive}" />
                                    <CheckBox x:Name="ModNotifCheck" Content="{DynamicResource Loc_Onboard_ModNotif}" />
                                    <CheckBox x:Name="ModClipboardCheck" Content="{DynamicResource Loc_Onboard_ModClipboard}" />
                                    <CheckBox x:Name="ModMouseCheck" Content="{DynamicResource Loc_Onboard_ModMouse}" />
                                    <CheckBox x:Name="ModAutoStartCheck" Margin="0" Content="{DynamicResource Loc_Onboard_ModAutoStart}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Footer -->
                    <DockPanel Grid.Row="2" Margin="0,16,0,0">
                        <!-- Step Indicator Dots -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Dot1" Width="18" Height="7" CornerRadius="3.5" Margin="0,0,5,0" Background="{DynamicResource ThemeAccentBrush}" />
                            <Border x:Name="Dot2" Width="7" Height="7" CornerRadius="3.5" Margin="0,0,5,0" Background="{DynamicResource ThemeCardBorderBrush}" />
                            <Border x:Name="Dot3" Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource ThemeCardBorderBrush}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BackBtn"
                                    Content="{DynamicResource Loc_Onboard_Back}"
                                    Visibility="Collapsed"
                                    Click="OnBackClick"
                                    Style="{StaticResource GlassBtnStyle}"
                                    Margin="0,0,8,0" />
                            <Button x:Name="NextOrFinishBtn"
                                    Content="{DynamicResource Loc_Onboard_Next}"
                                    Click="OnNextOrFinishClick"
                                    Style="{StaticResource AccentBtnStyle}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
