<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <FullSdk Condition="'$(FullSdk)'==''">false</FullSdk>
    <OutputType Condition="'$(FullSdk)'!='true'">Exe</OutputType>
    <OutputType Condition="'$(FullSdk)'=='true'">Library</OutputType>
    <TargetFramework Condition="'$(FullSdk)'!='true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(FullSdk)'=='true'">net8.0-windows10.0.19041.0</TargetFramework>
    <DefineConstants Condition="'$(FullSdk)'=='true'">$(DefineConstants);WITH_WINRT;WITH_ONNX;USE_XUNIT_PACKAGE</DefineConstants>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PulseIsland\PulseIsland.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(FullSdk)'=='true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>

</Project>
