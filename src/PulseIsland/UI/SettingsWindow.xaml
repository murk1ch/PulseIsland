<Window x:Class="PulseIsland.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_Settings_WindowTitle}"
        Width="720"
        Height="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource ThemeTextPrimaryBrush}"
        ResizeMode="CanMinimize"
        Loaded="OnWindowLoaded"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Crisp Vector Icons (Zero Emojis) -->
        <Geometry x:Key="CloseIconGeometry">M 1,1 L 10,10 M 10,1 L 1,10</Geometry>
        <Geometry x:Key="SlidersTabGeometry">M 1,2.5 L 11,2.5 M 1,6 L 11,6 M 1,9.5 L 11,9.5 M 4,1 A 1.5,1.5 0 1 1 4,4 A 1.5,1.5 0 1 1 4,1 Z M 8,4.5 A 1.5,1.5 0 1 1 8,7.5 A 1.5,1.5 0 1 1 8,4.5 Z M 5,8 A 1.5,1.5 0 1 1 5,11 A 1.5,1.5 0 1 1 5,8 Z</Geometry>
        <Geometry x:Key="TranslateTabGeometry">M 1,3.8 L 1,1 L 3.8,1 M 8.2,1 L 11,1 L 11,3.8 M 11,8.2 L 11,11 L 8.2,11 M 3.8,11 L 1,11 L 1,8.2 M 3.5,6 L 8.5,6 M 6,3.5 L 6,8.5</Geometry>
        <Geometry x:Key="WaveTabGeometry">M 1,6 L 1,6 M 3.5,3 L 3.5,9 M 6,1 L 6,11 M 8.5,3.5 L 8.5,8.5 M 11,5 L 11,7</Geometry>
        <Geometry x:Key="ComboArrowGeometry">M 1,2 L 5,6 L 9,2</Geometry>
        <Geometry x:Key="LightningBoltGeometry">M 6.5,0.5 L 1.2,6.8 L 5.0,6.8 L 3.8,11.5 L 10.2,5.0 L 6.2,5.0 Z</Geometry>

        <!-- Slim Themed Glass ScrollBar -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource ThemeScrollThumbBrush}"
                                CornerRadius="4"
                                Margin="2,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Background="{DynamicResource ThemeScrollTrackBrush}" CornerRadius="4" Margin="2,2" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="8" />
                                <Setter Property="MinHeight" Value="8" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed Frosted Glass ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="3,1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeButtonHoverBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeHighlightBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed Frosted Glass ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{DynamicResource ThemeControlBgBrush}"
                                                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="{StaticResource ComboArrowGeometry}"
                                                      Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Width="9" Height="6"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource ThemeButtonHoverBgBrush}" />
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource ThemeButtonBgBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,6,32,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   VerticalOffset="4">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource ThemePopupBgBrush}"
                                            BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="3,4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="16" ShadowDepth="4" Opacity="0.55" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed Glass ProgressBar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Track" CornerRadius="4" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Frosted Glass Section Card Style -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ThemeCardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeSectionHeaderBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Rounded Frosted Glass Pill Button -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeButtonHoverBgBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeButtonPressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Pill Button -->
        <Style x:Key="PrimaryNeonBtnStyle" TargetType="Button" BasedOn="{StaticResource ActionBtnStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentTextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{DynamicResource ThemeAccentGradientBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeGlassBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Glass TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="BoxBorder" Property="Background" Value="{DynamicResource ThemeButtonBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Glass PasswordBox Style -->
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Rounded Toggle Switch CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack"
                                    Grid.Column="0"
                                    Width="40" Height="22"
                                    CornerRadius="11"
                                    Background="{DynamicResource ThemeSwitchTrackOffBrush}"
                                    BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="16" Height="16"
                                         Fill="{DynamicResource ThemeSwitchThumbBrush}"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="2"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource ThemeAccentSecondaryBrush}" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource ThemeAccentTextBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchThumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="17" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchThumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Pill TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabPill"
                                CornerRadius="14"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                Background="{DynamicResource ThemeCardBgBrush}"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabPill" Property="Background" Value="{DynamicResource ThemeButtonHoverBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabPill" Property="Background" Value="{DynamicResource ThemeHighlightBrush}" />
                                <Setter TargetName="TabPill" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed Frosted Glass Slider -->
        <Style TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6"
                                    CornerRadius="3"
                                    Background="{DynamicResource ThemeSwitchTrackOffBrush}"
                                    BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                    BorderThickness="0.5"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        CornerRadius="3"
                                                        Background="{DynamicResource ThemeAccentGradientBrush}"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource ThemeAccentBrush}"
                                                         Stroke="{DynamicResource ThemeSwitchThumbBrush}"
                                                         StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootAnimatedGrid" Margin="18" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="WindowScaleTransform" ScaleX="1.0" ScaleY="1.0" />
        </Grid.RenderTransform>
        <Grid.Effect>
            <BlurEffect x:Name="WindowBlurEffect" Radius="0" KernelType="Gaussian" />
        </Grid.Effect>

        <!-- Soft Dark Ambient Shadow (No Neon Rim) -->
        <Border CornerRadius="28"
                Margin="-2"
                Background="#75000000"
                IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="20" KernelType="Gaussian" />
            </Border.Effect>
        </Border>

        <!-- Main Frosted Glass Window Surface -->
        <Border x:Name="MainSettingsCard"
                CornerRadius="26"
                BorderThickness="1"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeGlassBorderBrush}">

            <Grid>
                <!-- Specular Top Glass Reflection -->
                <Border CornerRadius="25,25,90,90"
                        Height="80"
                        VerticalAlignment="Top"
                        Background="{DynamicResource ThemeReflectionBrush}"
                        IsHitTestVisible="False" />

                <Grid Margin="22,18,22,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Draggable Glass Header (2-column Grid so buttons NEVER clip or overlap title/subtitle) -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,14"
                          Background="Transparent"
                          Cursor="SizeAll"
                          MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="9" Height="9" CornerRadius="4.5" Margin="0,0,10,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ThemeAccentGradientBrush}" />
                                <TextBlock Text="{DynamicResource Loc_Settings_Header}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="PortableRootText"
                                       FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       Margin="19,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{DynamicResource Loc_Settings_GuideBtn}"
                                    Click="OnOpenOnboardingGuideClick"
                                    Style="{StaticResource ActionBtnStyle}"
                                    FontSize="11.5"
                                    Padding="12,6"
                                    Margin="0,0,7,0"
                                    ToolTip="{DynamicResource Loc_Settings_GuideTooltip}" />
                            <Button Content="{DynamicResource Loc_Settings_ResetShort}"
                                    Click="OnResetDefaultsClick"
                                    Style="{StaticResource ActionBtnStyle}"
                                    FontSize="11.5"
                                    Padding="12,6"
                                    Margin="0,0,7,0"
                                    ToolTip="{DynamicResource Loc_Settings_ResetDefaults}" />
                            <Button Click="OnCancelClick"
                                    Style="{StaticResource ActionBtnStyle}"
                                    Width="34" Height="32"
                                    Padding="0"
                                    ToolTip="{DynamicResource Loc_Close}">
                                <Path Data="{StaticResource CloseIconGeometry}"
                                      Stroke="{DynamicResource ThemeTextPrimaryBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="10" Height="10"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Main Tabs -->
                    <TabControl x:Name="SettingsTabControl"
                                Grid.Row="1"
                                Background="Transparent"
                                BorderThickness="0"
                                SelectionChanged="OnTabSelectionChanged">
                        <!-- TAB 1: GENERAL & INTERFACE -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource SlidersTabGeometry}"
                                          Stroke="{DynamicResource ThemeTextPrimaryBrush}"
                                          StrokeThickness="1.3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,7,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Loc_Tab_General}" VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer Padding="4,12,8,4" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_Sec_Appearance}" Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock Text="{DynamicResource Loc_Field_UiLanguage}" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="UiLanguageCombo"
                                                      Padding="8,5"
                                                      Margin="0,0,0,10"
                                                      SelectionChanged="OnUiLanguageComboSelectionChanged">
                                                <ComboBoxItem Content="{DynamicResource Loc_Lang_English}" Tag="English" />
                                                <ComboBoxItem Content="{DynamicResource Loc_Lang_Russian}" Tag="Russian" />
                                            </ComboBox>

                                            <TextBlock Text="{DynamicResource Loc_Field_Theme}" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="ThemeStyleCombo"
                                                      Padding="8,5"
                                                      Margin="0,0,0,12"
                                                      SelectionChanged="OnThemeComboSelectionChanged">
                                                <ComboBoxItem Content="{DynamicResource Loc_Theme_Classic}" Tag="Classic" />
                                                <ComboBoxItem Content="{DynamicResource Loc_Theme_CrimsonBlack}" Tag="CrimsonBlack" />
                                                <ComboBoxItem Content="{DynamicResource Loc_Theme_IndigoAmber}" Tag="IndigoAmber" />
                                                <ComboBoxItem Content="{DynamicResource Loc_Theme_NavyMagenta}" Tag="NavyMagenta" />
                                                <ComboBoxItem Content="{DynamicResource Loc_Theme_GraphiteSand}" Tag="GraphiteSand" />
                                                <ComboBoxItem Content="{DynamicResource Loc_Theme_TealOrange}" Tag="TealOrange" />
                                                <ComboBoxItem Content="{DynamicResource Loc_Theme_LightWhite}" Tag="LightWhite" />
                                            </ComboBox>

                                            <CheckBox x:Name="EnableDwmBlurCheck"
                                                      Content="{DynamicResource Loc_Check_DwmBlur}"
                                                      Checked="OnLiveAppearanceOptionChanged"
                                                      Unchecked="OnLiveAppearanceOptionChanged"
                                                      Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowTrackProgressBarCheck"
                                                      Content="{DynamicResource Loc_Check_ProgressBar}"
                                                      Margin="0,0,0,8" />
                                            <CheckBox x:Name="EnableAlbumArtGlowCheck"
                                                      Content="{DynamicResource Loc_Check_AlbumGlow}"
                                                      Margin="0,0,0,8" />
                                            <CheckBox x:Name="UseCustomAppearanceCheck"
                                                      Content="{DynamicResource Loc_Check_CustomAppearance}"
                                                      Margin="0,0,0,10" />

                                            <Grid IsEnabled="{Binding ElementName=UseCustomAppearanceCheck, Path=IsChecked}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Loc_Field_CornerRadius}" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                                                        <TextBlock x:Name="CornerRadiusValueText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource ThemeSectionHeaderBrush}" FontSize="11.5" FontWeight="Bold" Text="24 px" />
                                                    </DockPanel>
                                                    <Slider x:Name="CornerRadiusSlider" Minimum="12" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                                            ValueChanged="OnAppearanceSliderChanged" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Loc_Field_Opacity}" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                                                        <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource ThemeSectionHeaderBrush}" FontSize="11.5" FontWeight="Bold" Text="96%" />
                                                    </DockPanel>
                                                    <Slider x:Name="OpacitySlider" Minimum="0.45" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                                            ValueChanged="OnAppearanceSliderChanged" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_Sec_SmartFeatures}" Style="{StaticResource SectionHeaderStyle}" />
                                            <CheckBox x:Name="EnableSmartClipboardCheck"
                                                      Content="{DynamicResource Loc_Check_SmartClipboard}"
                                                      Margin="0,0,0,8" />
                                            <CheckBox x:Name="EnableVolumeAndMicCheck"
                                                      Content="{DynamicResource Loc_Check_VolumeMic}"
                                                      Margin="0,0,0,8" />
                                            <CheckBox x:Name="EnableFileDropZoneCheck"
                                                      Content="{DynamicResource Loc_Check_FileDrop}"
                                                      Margin="0,0,0,8" />
                                            <CheckBox x:Name="EnableSystemLoadCheck"
                                                      Content="{DynamicResource Loc_Check_SystemLoad}"
                                                      Checked="OnSystemLoadChanged"
                                                      Unchecked="OnSystemLoadChanged" />
                                            <StackPanel x:Name="SystemIndicatorsPanel" Margin="24,8,0,0">
                                                <CheckBox x:Name="ShowCpuCheck"
                                                          Content="{DynamicResource Loc_Check_Cpu}"
                                                          Margin="0,0,0,6" />
                                                <CheckBox x:Name="ShowRamCheck"
                                                          Content="{DynamicResource Loc_Check_Ram}"
                                                          Margin="0,0,0,6" />
                                                <CheckBox x:Name="ShowTimeDateCheck"
                                                          Content="{DynamicResource Loc_Check_TimeDate}"
                                                          Margin="0,0,0,6" />
                                                <CheckBox x:Name="ShowNetworkSpeedCheck"
                                                          Content="{DynamicResource Loc_Check_NetSpeed}"
                                                          Margin="0,0,0,6" />
                                                <CheckBox x:Name="ShowBatteryCheck"
                                                          Content="{DynamicResource Loc_Check_PcBattery}"
                                                          Margin="0,0,0,6" />
                                                <CheckBox x:Name="ShowUptimeCheck"
                                                          Content="{DynamicResource Loc_Check_Uptime}" />
                                            </StackPanel>

                                            <!-- Collapsible Wireless Mouse Battery card -->
                                            <Border Background="{DynamicResource ThemeCardBgBrush}"
                                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="10,8"
                                                    Margin="0,10,0,0">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button x:Name="ToggleMouseBatteryDetailsBtn"
                                                                DockPanel.Dock="Right"
                                                                Content="{DynamicResource Loc_Btn_MoreSettings}"
                                                                Click="OnToggleMouseBatteryDetailsClick"
                                                                Style="{StaticResource ActionBtnStyle}"
                                                                Padding="9,4"
                                                                FontSize="11"
                                                                Margin="8,0,0,0" />
                                                        <Border x:Name="SettingsMouseBatteryPill"
                                                                DockPanel.Dock="Right"
                                                                Background="{DynamicResource ThemeControlBgBrush}"
                                                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="7,3"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path x:Name="SettingsMouseBolt"
                                                                      Data="{StaticResource LightningBoltGeometry}"
                                                                      Fill="{DynamicResource ThemeAccentBrush}"
                                                                      Width="9" Height="11"
                                                                      Stretch="Uniform"
                                                                      Margin="0,0,4,0"
                                                                      VerticalAlignment="Center" />
                                                                <TextBlock x:Name="SettingsMouseBatteryText"
                                                                           Text="--%"
                                                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <CheckBox x:Name="EnableMouseBatteryCheck"
                                                                  Content="{DynamicResource Loc_Check_MouseBattery}"
                                                                  VerticalAlignment="Center"
                                                                  Checked="OnMouseBatteryEnabledChanged"
                                                                  Unchecked="OnMouseBatteryEnabledChanged" />
                                                    </DockPanel>

                                                    <StackPanel x:Name="MouseBatteryDetailsPanel"
                                                                Visibility="Collapsed"
                                                                Margin="24,10,0,0">
                                                        <DockPanel Margin="0,0,0,8">
                                                            <Button x:Name="RefreshMouseBatteryBtn"
                                                                    DockPanel.Dock="Right"
                                                                    Content="{DynamicResource Loc_Refresh}"
                                                                    Click="OnRefreshMouseBatteryClick"
                                                                    Style="{StaticResource ActionBtnStyle}"
                                                                    Padding="9,4"
                                                                    FontSize="11"
                                                                    Margin="8,0,0,0" />
                                                            <TextBlock x:Name="SettingsMouseBatteryDetailText"
                                                                       Text="{DynamicResource Loc_Mouse_Searching}"
                                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                        </DockPanel>

                                                        <TextBlock Text="{DynamicResource Loc_Field_MouseConnMode}"
                                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                   FontSize="11.5"
                                                                   Margin="0,0,0,4" />
                                                        <ComboBox x:Name="MouseBatteryModeCombo"
                                                                  Padding="8,5"
                                                                  Margin="0,0,0,8"
                                                                  SelectionChanged="OnMouseBatteryModeSelectionChanged">
                                                            <ComboBoxItem Tag="Auto" Content="{DynamicResource Loc_MouseMode_Auto}" />
                                                            <ComboBoxItem Tag="Bluetooth" Content="{DynamicResource Loc_MouseMode_Bluetooth}" />
                                                            <ComboBoxItem Tag="Wireless24Ghz" Content="{DynamicResource Loc_MouseMode_24Ghz}" />
                                                        </ComboBox>

                                                        <CheckBox x:Name="ShowMouseBatteryInCompactCheck"
                                                                  Content="{DynamicResource Loc_Check_MouseCompact}"
                                                                  Margin="0,0,0,8" />

                                                        <CheckBox x:Name="EnableMouseLowBatterySoundCheck"
                                                                  Content="{DynamicResource Loc_Check_MouseLowSound}"
                                                                  Margin="0,0,0,6"
                                                                  Checked="OnMouseLowBatterySoundChanged"
                                                                  Unchecked="OnMouseLowBatterySoundChanged" />

                                                        <StackPanel x:Name="MouseLowBatterySoundSettingsPanel" Margin="24,0,0,0">
                                                            <DockPanel Margin="0,0,0,8">
                                                                <TextBlock Text="{DynamicResource Loc_Field_MouseThreshold}"
                                                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                           FontSize="11.5"
                                                                           VerticalAlignment="Center" />
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <TextBox x:Name="MouseLowBatteryThresholdBox"
                                                                             Width="52"
                                                                             Padding="8,4" />
                                                                    <TextBlock Text="%"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                               FontSize="11.5"
                                                                               Margin="6,0,0,0" />
                                                                </StackPanel>
                                                            </DockPanel>

                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right"
                                                                        Content="{DynamicResource Loc_PreviewSound}"
                                                                        Click="OnTestMouseLowBatterySoundClick"
                                                                        Style="{StaticResource ActionBtnStyle}"
                                                                        Margin="8,0,0,0" />
                                                                <ComboBox x:Name="MouseLowBatterySoundCombo" Padding="8,5">
                                                                    <ComboBoxItem Tag="SoftBubble" Content="{DynamicResource Loc_Sound_SoftBubble}" />
                                                                    <ComboBoxItem Tag="PulseChime" Content="{DynamicResource Loc_Sound_PulseChime}" />
                                                                    <ComboBoxItem Tag="CrystalDrop" Content="{DynamicResource Loc_Sound_CrystalDrop}" />
                                                                    <ComboBoxItem Tag="CosmicPing" Content="{DynamicResource Loc_Sound_CosmicPing}" />
                                                                    <ComboBoxItem Tag="SystemAsterisk" Content="{DynamicResource Loc_Sound_SystemAsterisk}" />
                                                                    <ComboBoxItem Tag="None" Content="{DynamicResource Loc_Sound_None}" />
                                                                </ComboBox>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Island Notifications section -->
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_Sec_Notifications}" Style="{StaticResource SectionHeaderStyle}" />
                                            <CheckBox x:Name="EnableIslandNotificationsCheck"
                                                      Content="{DynamicResource Loc_Check_EnableNotif}"
                                                      Margin="0,0,0,8"
                                                      Checked="OnIslandNotificationsChanged"
                                                      Unchecked="OnIslandNotificationsChanged" />
                                            <StackPanel x:Name="IslandNotificationsPanel" Margin="24,0,0,0">
                                                <CheckBox x:Name="SuppressWindowsToastCheck"
                                                          Content="{DynamicResource Loc_Check_SuppressToast}"
                                                          Margin="0,0,0,8" />
                                                <TextBlock Text="{DynamicResource Loc_Field_NotifDismiss}"
                                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                           FontSize="11.5"
                                                           Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBox x:Name="NotifAutoDismissBox"
                                                             Width="60"
                                                             Padding="8,5" />
                                                    <TextBlock Text="{DynamicResource Loc_Sec}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                               FontSize="11.5"
                                                               Margin="8,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource Loc_Field_NotifSound}"
                                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                           FontSize="11.5"
                                                           Margin="0,0,0,4" />
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="{DynamicResource Loc_PreviewSound}"
                                                            Click="OnTestNotificationSoundClick"
                                                            Style="{StaticResource ActionBtnStyle}"
                                                            Margin="8,0,0,0" />
                                                    <ComboBox x:Name="NotificationSoundCombo" Padding="8,5">
                                                        <ComboBoxItem Tag="PulseChime" Content="{DynamicResource Loc_Sound_PulseChime}" />
                                                        <ComboBoxItem Tag="CrystalDrop" Content="{DynamicResource Loc_Sound_CrystalDrop}" />
                                                        <ComboBoxItem Tag="SoftBubble" Content="{DynamicResource Loc_Sound_SoftBubble}" />
                                                        <ComboBoxItem Tag="CosmicPing" Content="{DynamicResource Loc_Sound_CosmicPing}" />
                                                        <ComboBoxItem Tag="SystemAsterisk" Content="{DynamicResource Loc_Sound_SystemAsterisk}" />
                                                        <ComboBoxItem Tag="None" Content="{DynamicResource Loc_Sound_None}" />
                                                    </ComboBox>
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_Sec_System}" Style="{StaticResource SectionHeaderStyle}" />
                                            <CheckBox x:Name="AutoStartCheck"
                                                      Content="{DynamicResource Loc_Check_AutoStart}"
                                                      Margin="0,0,0,10" />
                                            <CheckBox x:Name="ShowTrayCheck"
                                                      Content="{DynamicResource Loc_Check_TrayIcon}"
                                                      Margin="0,0,0,10" />
                                            <CheckBox x:Name="HideFullscreenCheck"
                                                      Content="{DynamicResource Loc_Check_HideFullscreen}"
                                                      Margin="0,0,0,12" />

                                            <TextBlock Text="{DynamicResource Loc_Field_Monitor}" Style="{StaticResource FieldLabelStyle}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Content="{DynamicResource Loc_Refresh}"
                                                        Click="OnRefreshMonitorsClick"
                                                        Style="{StaticResource ActionBtnStyle}"
                                                        Margin="8,0,0,0" />
                                                <ComboBox x:Name="MonitorCombo" Padding="8,5" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_Sec_Behavior}" Style="{StaticResource SectionHeaderStyle}" />
                                            <DockPanel Margin="0,0,0,10">
                                                <Border x:Name="PinStateBadge"
                                                        DockPanel.Dock="Right"
                                                        CornerRadius="9"
                                                        Padding="9,3"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeCardBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=PinIslandCheck, Path=IsChecked}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ThemeHighlightBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10.5" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{DynamicResource Loc_Off}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=PinIslandCheck, Path=IsChecked}" Value="True">
                                                                        <Setter Property="Text" Value="{DynamicResource Loc_On}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <CheckBox x:Name="PinIslandCheck"
                                                          Content="{DynamicResource Loc_Check_PinIsland}"
                                                          Checked="OnPinIslandChanged"
                                                          Unchecked="OnPinIslandChanged" />
                                            </DockPanel>
                                            <CheckBox x:Name="ExpandOnHoverCheck"
                                                      Content="{DynamicResource Loc_Check_ExpandHover}"
                                                      Checked="OnExpandOnHoverChanged"
                                                      Unchecked="OnExpandOnHoverChanged"
                                                      Margin="0,0,0,8" />
                                            <CheckBox x:Name="CollapseOnMouseLeaveCheck"
                                                      Content="{DynamicResource Loc_Check_CollapseLeave}"
                                                      Margin="24,0,0,14" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Field_AutoHideDelay}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="AutoHideDelayBox" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Loc_Field_HoverZone}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="TopHoverTriggerBox" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: TRANSLATOR & OFFLINE MODELS -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource TranslateTabGeometry}"
                                          Stroke="{DynamicResource ThemeTextPrimaryBrush}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,7,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Loc_Tab_TranslatorAi}" VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer Padding="4,12,8,4" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_Sec_TranslatorEngine}" Style="{StaticResource SectionHeaderStyle}" />

                                            <TextBlock Text="{DynamicResource Loc_Field_TransMode}" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="TranslationModeCombo" Padding="8,5" Margin="0,0,0,10">
                                                <ComboBoxItem Content="{DynamicResource Loc_TransMode_Hybrid}" Tag="OnlineWindowsOcr" />
                                                <ComboBoxItem Content="{DynamicResource Loc_TransMode_Offline}" Tag="OfflineOnnx" />
                                                <ComboBoxItem Content="{DynamicResource Loc_TransMode_OfflineLlm}" Tag="OfflineLocalLlm" />
                                            </ComboBox>

                                            <TextBlock Text="{DynamicResource Loc_Field_OcrEngine}" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="OcrModeCombo" Padding="8,5" Margin="0,0,0,10">
                                                <ComboBoxItem Content="{DynamicResource Loc_OcrMode_AutoSmart}" Tag="AutoSmart" />
                                                <ComboBoxItem Content="{DynamicResource Loc_OcrMode_VisionAlways}" Tag="VisionLlmAlways" />
                                                <ComboBoxItem Content="{DynamicResource Loc_OcrMode_WindowsOnly}" Tag="WindowsOcrOnly" />
                                            </ComboBox>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Field_TargetLang}" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox x:Name="TargetLangCombo" DisplayMemberPath="FullLabel" SelectedValuePath="Code" Padding="8,5" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Loc_Field_SourceLang}" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox x:Name="ManualSourceLangCombo" DisplayMemberPath="FullLabel" SelectedValuePath="Code" Padding="8,5" />
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox x:Name="AutoDetectLangCheck"
                                                      Content="{DynamicResource Loc_Check_AutoDetectLang}"
                                                      Margin="0,0,0,12" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="225" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Field_OnlineProvider}" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox x:Name="OnlineProviderCombo" Padding="8,5">
                                                        <ComboBoxItem Content="{DynamicResource Loc_Provider_Google}" Tag="GoogleFree" />
                                                        <ComboBoxItem Content="{DynamicResource Loc_Provider_DeepL}" Tag="DeepL" />
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock x:Name="DeepLKeyLabel" Text="{DynamicResource Loc_Field_DeepLKey}" Style="{StaticResource FieldLabelStyle}" />
                                                    <PasswordBox x:Name="DeepLKeyBox" />
                                                </StackPanel>

                                                <Button Grid.Column="4"
                                                        VerticalAlignment="Bottom"
                                                        Content="{DynamicResource Loc_Clear}"
                                                        Click="OnClearApiKeyClick"
                                                        Style="{StaticResource ActionBtnStyle}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_Sec_HotkeysTrail}" Style="{StaticResource SectionHeaderStyle}" />

                                            <TextBlock Text="{DynamicResource Loc_Field_LassoHotkey}" Style="{StaticResource FieldLabelStyle}" />
                                            <DockPanel Margin="0,0,0,10">
                                                <Button x:Name="RecordHotkeyBtn"
                                                        DockPanel.Dock="Right"
                                                        Content="{DynamicResource Loc_Btn_RecordHotkey}"
                                                        Click="OnRecordHotkeyClick"
                                                        Style="{StaticResource ActionBtnStyle}"
                                                        Margin="8,0,0,0" />
                                                <TextBox x:Name="HotkeyBox" />
                                            </DockPanel>

                                            <CheckBox x:Name="EnableClipboardTranslateCheck"
                                                      Content="{DynamicResource Loc_Check_ClipHotkey}"
                                                      Margin="0,0,0,6" />
                                            <DockPanel Margin="0,0,0,12" IsEnabled="{Binding ElementName=EnableClipboardTranslateCheck, Path=IsChecked}">
                                                <Button x:Name="RecordClipboardHotkeyBtn"
                                                        DockPanel.Dock="Right"
                                                        Content="{DynamicResource Loc_Btn_RecordHotkey}"
                                                        Click="OnRecordClipboardHotkeyClick"
                                                        Style="{StaticResource ActionBtnStyle}"
                                                        Margin="8,0,0,0" />
                                                <TextBox x:Name="ClipboardHotkeyBox" />
                                            </DockPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Field_TrailLen}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="TrailLengthBox" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Loc_Field_TrailWidth}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="TrailThicknessBox" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="{DynamicResource Loc_Field_TrailOpacity}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="TrailOpacityBox" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="6">
                                                    <TextBlock Text="{DynamicResource Loc_Field_PopupTimer}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="PopupAutoHideBox" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Offline Models Manager -->
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{DynamicResource Loc_Sec_OfflineModels}"
                                                           Style="{StaticResource SectionHeaderStyle}"
                                                           Margin="0" />
                                                <StackPanel DockPanel.Dock="Right"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right">
                                                    <Button Content="{DynamicResource Loc_Btn_OpenFolder}"
                                                            Click="OnOpenModelsFolderClick"
                                                            Style="{StaticResource ActionBtnStyle}"
                                                            FontSize="11"
                                                            Padding="12,4"
                                                            Margin="0,0,6,0" />
                                                    <Button Content="{DynamicResource Loc_Btn_RefreshList}"
                                                            Click="OnRefreshModelsClick"
                                                            Style="{StaticResource ActionBtnStyle}"
                                                            FontSize="11"
                                                            Padding="12,4" />
                                                </StackPanel>
                                            </DockPanel>

                                            <TextBlock x:Name="DiskSummaryText"
                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                       FontSize="11.5"
                                                       Margin="0,0,0,8" />

                                            <!-- Active download progress bar -->
                                            <Border x:Name="DownloadProgressPanel"
                                                    Visibility="Collapsed"
                                                    Background="{DynamicResource ThemeHighlightBrush}"
                                                    BorderBrush="{DynamicResource ThemeAccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock x:Name="DownloadStatusText"
                                                                   DockPanel.Dock="Left"
                                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                   FontSize="11.5" />
                                                        <Button DockPanel.Dock="Right"
                                                                HorizontalAlignment="Right"
                                                                Content="{DynamicResource Loc_CancelDownload}"
                                                                Click="OnCancelModelDownloadClick"
                                                                Style="{StaticResource ActionBtnStyle}"
                                                                FontSize="10.5"
                                                                Padding="10,3" />
                                                    </DockPanel>
                                                    <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Height="8" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{DynamicResource Loc_Field_OfflineModelSelect}" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="OfflineModelCombo"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="ModelId"
                                                      SelectionChanged="OnOfflineModelSelectionChanged"
                                                      Padding="8,5"
                                                      Margin="0,0,0,8" />

                                            <Border Background="{DynamicResource ThemeCardBgBrush}"
                                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="12,10">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="8,0,0,0">
                                                        <Button x:Name="DownloadOfflineModelBtn"
                                                                Content="{DynamicResource Loc_Download}"
                                                                Click="OnDownloadSelectedOfflineModelClick"
                                                                Style="{StaticResource ActionBtnStyle}"
                                                                FontSize="11"
                                                                Padding="12,5"
                                                                Margin="0,0,6,0" />
                                                        <Button x:Name="DeleteOfflineModelBtn"
                                                                Content="{DynamicResource Loc_Delete}"
                                                                Click="OnDeleteSelectedOfflineModelClick"
                                                                Style="{StaticResource ActionBtnStyle}"
                                                                FontSize="11"
                                                                Padding="12,5" />
                                                    </StackPanel>

                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="OfflineModelTitleText"
                                                                       Grid.Column="0"
                                                                       Text="Opus-MT (ONNX)"
                                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <Border x:Name="OfflineModelActiveBadge"
                                                                    Grid.Column="1"
                                                                    Background="{DynamicResource ThemeHighlightBrush}"
                                                                    CornerRadius="7"
                                                                    Padding="6,1"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="Collapsed">
                                                                <TextBlock Text="{DynamicResource Loc_Active}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="9.5" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock x:Name="OfflineModelDescText"
                                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,2" />
                                                        <TextBlock x:Name="OfflineModelSizeText"
                                                                   Foreground="{DynamicResource ThemeSectionHeaderBrush}"
                                                                   FontSize="10.5" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Local AI Assistant (GGUF GPU/CPU) -->
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_Sec_LocalAi}" Style="{StaticResource SectionHeaderStyle}" />
                                            <CheckBox x:Name="EnableLocalAiCheck"
                                                      Content="{DynamicResource Loc_Check_EnableAi}"
                                                      Margin="0,0,0,10" />

                                            <TextBlock Text="{DynamicResource Loc_Field_LocalAiModelSelect}" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="AiModelCombo"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="ModelId"
                                                      SelectionChanged="OnAiModelSelectionChanged"
                                                      Padding="8,5"
                                                      Margin="0,0,0,8" />

                                            <Border Background="{DynamicResource ThemeCardBgBrush}"
                                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="12,10"
                                                    Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="AiModelTitleText"
                                                                       Grid.Column="0"
                                                                       Text="Qwen 2.5 3B Instruct (Q4_K_M • GGUF)"
                                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <Border x:Name="AiReadyBadge"
                                                                    Grid.Column="1"
                                                                    Background="{DynamicResource ThemeHighlightBrush}"
                                                                    CornerRadius="7"
                                                                    Padding="6,1"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="Collapsed">
                                                                <TextBlock Text="{DynamicResource Loc_Active}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="9.5" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock x:Name="AiModelDescText"
                                                                   Text="{DynamicResource Loc_Ai_ModelDesc}"
                                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,2" />
                                                        <TextBlock x:Name="AiModelStatusText"
                                                                   Foreground="{DynamicResource ThemeSectionHeaderBrush}"
                                                                   FontSize="10.5"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock x:Name="AiHardwareText"
                                                                   Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                                   FontSize="10"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button x:Name="DownloadAiBtn"
                                                                Content="{DynamicResource Loc_Download}"
                                                                Click="OnDownloadAiPackageClick"
                                                                Style="{StaticResource ActionBtnStyle}"
                                                                FontSize="11"
                                                                Padding="12,5"
                                                                Margin="0,0,6,0" />
                                                        <Button x:Name="DeleteAiBtn"
                                                                Content="{DynamicResource Loc_Delete}"
                                                                Click="OnDeleteAiPackageClick"
                                                                Style="{StaticResource ActionBtnStyle}"
                                                                FontSize="11"
                                                                Padding="12,5" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Field_AiBackend}" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox x:Name="AiBackendCombo" Padding="8,5">
                                                        <ComboBoxItem Tag="Auto" Content="{DynamicResource Loc_AiBackend_Auto}" />
                                                        <ComboBoxItem Tag="GpuVulkan" Content="{DynamicResource Loc_AiBackend_Gpu}" />
                                                        <ComboBoxItem Tag="CpuOnly" Content="{DynamicResource Loc_AiBackend_Cpu}" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Loc_Field_WeatherCity}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="AiWeatherCityBox" Padding="8,5" />
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox x:Name="EnableAiFeedHotkeyCheck"
                                                      Content="{DynamicResource Loc_Check_AiHotkey}"
                                                      Margin="0,12,0,6" />
                                            <Grid IsEnabled="{Binding ElementName=EnableAiFeedHotkeyCheck, Path=IsChecked}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <DockPanel Grid.Column="0">
                                                    <Button x:Name="RecordAiHotkeyBtn"
                                                            DockPanel.Dock="Right"
                                                            Content="{DynamicResource Loc_Btn_RecordShort}"
                                                            Click="OnRecordAiHotkeyClick"
                                                            Style="{StaticResource ActionBtnStyle}"
                                                            Margin="6,0,0,0" />
                                                    <TextBox x:Name="AiFeedHotkeyBox" Padding="8,5" />
                                                </DockPanel>
                                                <ComboBox x:Name="AiFeedActionCombo" Grid.Column="2" Padding="8,5">
                                                    <ComboBoxItem Tag="Summarize" Content="{DynamicResource Loc_AiAction_Summarize}" />
                                                    <ComboBoxItem Tag="Translate" Content="{DynamicResource Loc_AiAction_Translate}" />
                                                    <ComboBoxItem Tag="FillPrompt" Content="{DynamicResource Loc_AiAction_FillPrompt}" />
                                                </ComboBox>
                                            </Grid>

                                            <!-- Offline Whisper Voice Dictation Card (2-column Grid so buttons never clip) -->
                                            <Border Background="{DynamicResource ThemeCardBgBrush}"
                                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="12,10"
                                                    Margin="0,12,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{DynamicResource Loc_Whisper_Title}"
                                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <Border x:Name="WhisperReadyBadge"
                                                                    Grid.Column="1"
                                                                    Background="{DynamicResource ThemeHighlightBrush}"
                                                                    CornerRadius="7"
                                                                    Padding="6,1"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="Collapsed">
                                                                <TextBlock Text="{DynamicResource Loc_ReadyBadge}" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="9.5" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Text="{DynamicResource Loc_Whisper_Desc}"
                                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,2" />
                                                        <TextBlock x:Name="WhisperStatusText"
                                                                   Foreground="{DynamicResource ThemeSectionHeaderBrush}"
                                                                   FontSize="10.5"
                                                                   TextWrapping="Wrap"
                                                                   Text="{DynamicResource Loc_Whisper_Checking}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button x:Name="DownloadWhisperBtn"
                                                                Content="{DynamicResource Loc_Download}"
                                                                Click="OnDownloadWhisperClick"
                                                                Style="{StaticResource ActionBtnStyle}"
                                                                FontSize="11"
                                                                Padding="12,5"
                                                                Margin="0,0,6,0" />
                                                        <Button x:Name="DeleteWhisperBtn"
                                                                Content="{DynamicResource Loc_Delete}"
                                                                Click="OnDeleteWhisperClick"
                                                                Style="{StaticResource ActionBtnStyle}"
                                                                FontSize="11"
                                                                Padding="12,5" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Custom User Quick-Action Prompt Chips -->
                                            <Border Background="{DynamicResource ThemeCardBgBrush}"
                                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="12,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{DynamicResource Loc_CustomPrompts_Header}"
                                                                   Foreground="{DynamicResource ThemeSectionHeaderBrush}"
                                                                   FontSize="10.5"
                                                                   FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0" />
                                                        <Button Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                Content="{DynamicResource Loc_Defaults}"
                                                                Click="OnResetCustomPromptsClick"
                                                                Style="{StaticResource ActionBtnStyle}"
                                                                FontSize="10.5"
                                                                Padding="9,3" />
                                                    </Grid>

                                                    <ItemsControl x:Name="CustomPromptsListControl" Margin="0,0,0,8">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{DynamicResource ThemeControlBgBrush}"
                                                                        BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="10"
                                                                        Padding="9,4"
                                                                        Margin="0,0,6,6"
                                                                        ToolTip="{Binding PromptTemplate}">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,7,0" />
                                                                        <Button Tag="{Binding}"
                                                                                Click="OnRemoveCustomPromptClick"
                                                                                Style="{StaticResource ActionBtnStyle}"
                                                                                Width="18" Height="18"
                                                                                Padding="0"
                                                                                ToolTip="{DynamicResource Loc_CustomPrompts_DeleteTooltip}">
                                                                            <Path Data="{StaticResource CloseIconGeometry}"
                                                                                  Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                                                                                  StrokeThickness="1.4"
                                                                                  Width="7" Height="7"
                                                                                  Stretch="Uniform" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="155" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left Input with In-Box Placeholder -->
                                                        <Grid Grid.Column="0">
                                                            <TextBox x:Name="NewPromptTitleBox"
                                                                     Padding="10,6"
                                                                     VerticalContentAlignment="Center"
                                                                     ToolTip="{DynamicResource Loc_CustomPrompts_TitleTooltip}" />
                                                            <TextBlock Text="{DynamicResource Loc_CustomPrompts_TitlePlaceholder}"
                                                                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                                       FontSize="11.5"
                                                                       Margin="12,0,8,0"
                                                                       VerticalAlignment="Center"
                                                                       IsHitTestVisible="False">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=NewPromptTitleBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <!-- Right Input with In-Box Placeholder -->
                                                        <Grid Grid.Column="2">
                                                            <TextBox x:Name="NewPromptTemplateBox"
                                                                     Padding="10,6"
                                                                     VerticalContentAlignment="Center"
                                                                     ToolTip="{DynamicResource Loc_CustomPrompts_BodyTooltip}" />
                                                            <TextBlock Text="{DynamicResource Loc_CustomPrompts_BodyPlaceholder}"
                                                                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                                       FontSize="11.5"
                                                                       Margin="12,0,8,0"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsHitTestVisible="False">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=NewPromptTemplateBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <Button Grid.Column="4"
                                                                Content="{DynamicResource Loc_CustomPrompts_AddBtn}"
                                                                Click="OnAddCustomPromptClick"
                                                                Style="{StaticResource ActionBtnStyle}"
                                                                FontSize="11"
                                                                Padding="12,6" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: MUSIC & WAVES -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource WaveTabGeometry}"
                                          Stroke="{DynamicResource ThemeTextPrimaryBrush}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,7,0"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Loc_Tab_Music}" VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer Padding="4,12,8,4" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_Sec_MusicIntegration}" Style="{StaticResource SectionHeaderStyle}" />
                                            <CheckBox x:Name="EnableMusicCheck"
                                                      Content="{DynamicResource Loc_Check_EnableMusic}"
                                                      Margin="0,0,0,10" />
                                            <CheckBox x:Name="ShowAlbumArtCheck"
                                                      Content="{DynamicResource Loc_Check_ShowAlbumArt}"
                                                      Margin="0,0,0,10" />
                                            <CheckBox x:Name="MarqueeCheck"
                                                      Content="{DynamicResource Loc_Check_Marquee}"
                                                      Margin="0,0,0,10" />
                                            <CheckBox x:Name="HideMusicOnPauseCheck"
                                                      Content="{DynamicResource Loc_Check_HideMusicPause}"
                                                      Margin="0,0,0,12" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Field_PauseDelay}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="PauseHideDelayBox" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Loc_Field_AudioDevice}" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox x:Name="AudioDeviceCombo"
                                                              DisplayMemberPath="DisplayName"
                                                              SelectedValuePath="DeviceId"
                                                              Padding="8,5" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SectionCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_Sec_WavePhysics}" Style="{StaticResource SectionHeaderStyle}" />

                                            <CheckBox x:Name="HideWavesSilenceCheck"
                                                      Content="{DynamicResource Loc_Check_HideSilence}"
                                                      Margin="0,0,0,12" />

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Field_WaveStyle}" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox x:Name="WaveStyleCombo" Padding="8,5">
                                                        <ComboBoxItem Content="{DynamicResource Loc_WaveStyle_Smooth}" Tag="SmoothCurve" />
                                                        <ComboBoxItem Content="{DynamicResource Loc_WaveStyle_Bars}" Tag="Bars" />
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Loc_Field_WaveColorMode}" Style="{StaticResource FieldLabelStyle}" />
                                                    <ComboBox x:Name="WaveColorModeCombo" Padding="8,5">
                                                        <ComboBoxItem Content="{DynamicResource Loc_WaveColor_Theme}" Tag="ThemeAdaptive" />
                                                        <ComboBoxItem Content="{DynamicResource Loc_WaveColor_Album}" Tag="AlbumAdaptive" />
                                                        <ComboBoxItem Content="{DynamicResource Loc_WaveColor_Gradient}" Tag="Gradient" />
                                                        <ComboBoxItem Content="{DynamicResource Loc_WaveColor_Static}" Tag="Static" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Field_WaveBars}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="WaveBarCountBox" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Loc_Field_WaveSens}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="WaveSensitivityBox" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="{DynamicResource Loc_Field_WaveSmooth}" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox x:Name="WaveSmoothingBox" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Field_PrimaryColor}" Style="{StaticResource FieldLabelStyle}" />
                                                    <DockPanel>
                                                        <Button x:Name="StaticColorPreviewBtn"
                                                                DockPanel.Dock="Left"
                                                                Width="34" Height="34"
                                                                Margin="0,0,8,0"
                                                                Tag="Primary"
                                                                Click="OnOpenColorPaletteClick"
                                                                Cursor="Hand"
                                                                ToolTip="{DynamicResource Loc_Tooltip_ColorPicker}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{DynamicResource ThemeGlassBorderBrush}"
                                                                            BorderThickness="1.5"
                                                                            CornerRadius="17" />
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <TextBox x:Name="StaticColorHexBox" TextChanged="OnWaveHexTextChanged" />
                                                    </DockPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Loc_Field_SecondaryColor}" Style="{StaticResource FieldLabelStyle}" />
                                                    <DockPanel>
                                                        <Button x:Name="GradientColorPreviewBtn"
                                                                DockPanel.Dock="Left"
                                                                Width="34" Height="34"
                                                                Margin="0,0,8,0"
                                                                Tag="Secondary"
                                                                Click="OnOpenColorPaletteClick"
                                                                Cursor="Hand"
                                                                ToolTip="{DynamicResource Loc_Tooltip_ColorPicker}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{DynamicResource ThemeGlassBorderBrush}"
                                                                            BorderThickness="1.5"
                                                                            CornerRadius="17" />
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <TextBox x:Name="GradientColorHexBox" TextChanged="OnWaveHexTextChanged" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Themed Interactive Frosted Glass Color Palette Popup -->
                                            <Popup x:Name="ColorPalettePopup"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True"
                                                   Placement="Top"
                                                   VerticalOffset="-8"
                                                   PopupAnimation="Fade">
                                                <Border Margin="10"
                                                        Padding="14"
                                                        Width="278"
                                                        CornerRadius="18"
                                                        Background="{DynamicResource ThemePopupBgBrush}"
                                                        BorderBrush="{DynamicResource ThemeGlassBorderBrush}"
                                                        BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="{DynamicResource ThemeShadowColor}" BlurRadius="18" ShadowDepth="4" Opacity="0.55" />
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,10">
                                                            <TextBlock x:Name="PaletteTitleText"
                                                                       DockPanel.Dock="Left"
                                                                       Text="{DynamicResource Loc_ColorPicker_Title}"
                                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                            <Border x:Name="PaletteLivePreview"
                                                                    DockPanel.Dock="Right"
                                                                    HorizontalAlignment="Right"
                                                                    Width="24" Height="24"
                                                                    CornerRadius="12"
                                                                    BorderBrush="{DynamicResource ThemeGlassBorderBrush}"
                                                                    BorderThickness="1" />
                                                        </DockPanel>

                                                        <!-- 2D Saturation / Value Picker -->
                                                        <Border CornerRadius="10"
                                                                ClipToBounds="True"
                                                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                                BorderThickness="1"
                                                                Height="130"
                                                                Margin="0,0,0,10">
                                                            <Canvas x:Name="SvPickerCanvas"
                                                                    Width="248" Height="130"
                                                                    Cursor="Cross"
                                                                    MouseLeftButtonDown="OnSvCanvasMouseDown"
                                                                    MouseMove="OnSvCanvasMouseMove"
                                                                    MouseLeftButtonUp="OnSvCanvasMouseUp">
                                                                <Rectangle x:Name="SvHueBackground" Width="248" Height="130" Fill="#FF38BDF8" />
                                                                <Rectangle Width="248" Height="130">
                                                                    <Rectangle.Fill>
                                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Rectangle.Fill>
                                                                </Rectangle>
                                                                <Rectangle Width="248" Height="130">
                                                                    <Rectangle.Fill>
                                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                            <GradientStop Color="#00000000" Offset="0" />
                                                                            <GradientStop Color="#FF000000" Offset="1" />
                                                                        </LinearGradientBrush>
                                                                    </Rectangle.Fill>
                                                                </Rectangle>
                                                                <Ellipse x:Name="SvThumb"
                                                                         Width="14" Height="14"
                                                                         Stroke="#FFFFFFFF"
                                                                         StrokeThickness="2"
                                                                         Fill="Transparent"
                                                                         IsHitTestVisible="False" />
                                                            </Canvas>
                                                        </Border>

                                                        <!-- Hue Spectrum Slider -->
                                                        <Border CornerRadius="7"
                                                                ClipToBounds="True"
                                                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                                BorderThickness="1"
                                                                Height="14"
                                                                Margin="0,0,0,10">
                                                            <Canvas x:Name="HuePickerCanvas"
                                                                    Width="248" Height="14"
                                                                    Cursor="Hand"
                                                                    MouseLeftButtonDown="OnHueCanvasMouseDown"
                                                                    MouseMove="OnHueCanvasMouseMove"
                                                                    MouseLeftButtonUp="OnHueCanvasMouseUp">
                                                                <Rectangle Width="248" Height="14">
                                                                    <Rectangle.Fill>
                                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                            <GradientStop Color="#FFFF0000" Offset="0.00" />
                                                                            <GradientStop Color="#FFFFFF00" Offset="0.17" />
                                                                            <GradientStop Color="#FF00FF00" Offset="0.33" />
                                                                            <GradientStop Color="#FF00FFFF" Offset="0.50" />
                                                                            <GradientStop Color="#FF0000FF" Offset="0.67" />
                                                                            <GradientStop Color="#FFFF00FF" Offset="0.83" />
                                                                            <GradientStop Color="#FFFF0000" Offset="1.00" />
                                                                        </LinearGradientBrush>
                                                                    </Rectangle.Fill>
                                                                </Rectangle>
                                                                <Border x:Name="HueThumb"
                                                                        Width="8" Height="14"
                                                                        CornerRadius="3"
                                                                        BorderBrush="#FFFFFFFF"
                                                                        BorderThickness="1.5"
                                                                        Background="Transparent"
                                                                        IsHitTestVisible="False" />
                                                            </Canvas>
                                                        </Border>

                                                        <!-- Quick Curated Color Swatches -->
                                                        <WrapPanel x:Name="PresetSwatchesPanel" Margin="0,0,0,10" />

                                                        <DockPanel>
                                                            <TextBlock x:Name="PaletteHexReadout"
                                                                       DockPanel.Dock="Left"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="12"
                                                                       Text="#FF7DD3FC" />
                                                            <Button DockPanel.Dock="Right"
                                                                    HorizontalAlignment="Right"
                                                                    Content="{DynamicResource Loc_Done}"
                                                                    Click="OnCloseColorPaletteClick"
                                                                    Style="{StaticResource ActionBtnStyle}"
                                                                    Padding="14,4"
                                                                    FontSize="11.5" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- Footer (2-column Grid so long status text NEVER overlaps Cancel/Save buttons) -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="FooterStatusText"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   FontSize="12" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Loc_Cancel}"
                                    Click="OnCancelClick"
                                    Style="{StaticResource ActionBtnStyle}"
                                    Width="112" Height="36" Margin="0,0,10,0" />
                            <Button Content="{DynamicResource Loc_Settings_SaveBtn}"
                                    Click="OnSaveClick"
                                    Style="{StaticResource PrimaryNeonBtnStyle}"
                                    Width="176" Height="36" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
