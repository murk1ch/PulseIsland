<Window x:Class="PulseIsland.UI.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MaxWidth="490">

    <Window.Resources>
        <Geometry x:Key="CloseIconGeometry">M 1,1 L 9,9 M 9,1 L 1,9</Geometry>
        <Geometry x:Key="SwapLangGeometry">M 1.5,3.5 L 10.5,3.5 M 8,1 L 10.5,3.5 L 8,6 M 10.5,8.5 L 1.5,8.5 M 4,6 L 1.5,8.5 L 4,11</Geometry>

        <Style x:Key="PopupScrollThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="{DynamicResource ThemeScrollThumbBrush}" CornerRadius="3" Margin="2,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Background="{DynamicResource ThemeScrollTrackBrush}" CornerRadius="3.5" Margin="1.5,2" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PopupScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeButtonHoverBgBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeButtonPressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootPopupContainer"
          Margin="16"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PopupScaleTransform" ScaleX="0.92" ScaleY="0.92" />
        </Grid.RenderTransform>
        <Grid.Effect>
            <BlurEffect x:Name="PopupBlurEffect" Radius="8" />
        </Grid.Effect>

        <!-- Soft Ambient Shadow (No Neon Rim) -->
        <Border CornerRadius="22"
                Margin="-2"
                Background="#70000000"
                IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="18" />
            </Border.Effect>
        </Border>

        <!-- Main Frosted Glass Card (drag anywhere to reposition) -->
        <Border x:Name="MainPopupCard"
                Padding="16,14"
                CornerRadius="20"
                BorderThickness="1"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeGlassBorderBrush}"
                MouseLeftButtonDown="OnPopupMouseLeftButtonDown">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Specular Glass Reflection -->
                <Border Grid.Row="0"
                        Height="14"
                        VerticalAlignment="Top"
                        Margin="-10,-10,-10,0"
                        CornerRadius="16,16,0,0"
                        Background="{DynamicResource ThemeReflectionBrush}"
                        IsHitTestVisible="False" />

                <!-- Header (2-column Grid so buttons never collide or clip) -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                HorizontalAlignment="Left"
                                Padding="8,3"
                                CornerRadius="10"
                                Background="{DynamicResource ThemeHighlightBrush}"
                                BorderBrush="{DynamicResource ThemeAccentBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="LangBadgeText"
                                       Text="AUTO → EN"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Button x:Name="SwapDirectionButton"
                                Grid.Column="1"
                                Click="OnSwapDirectionClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Padding="7,4"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="{DynamicResource Loc_TransPopup_SwapTooltip}">
                            <Path Data="{StaticResource SwapLangGeometry}"
                                  Stroke="{DynamicResource ThemeAccentBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="11" Height="11"
                                  Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="AskAiButton"
                                Content="{DynamicResource Loc_TransPopup_AskAiBtn}"
                                Click="OnAskAiClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Padding="9,4"
                                Margin="0,0,5,0"
                                FontSize="11"
                                ToolTip="{DynamicResource Loc_TransPopup_AskAiTooltip}" />
                        <Button x:Name="CopyButton"
                                Content="{DynamicResource Loc_Copy}"
                                Click="OnCopyClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Padding="9,4"
                                Margin="0,0,5,0"
                                FontSize="11" />
                        <Button Click="OnCloseClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Width="26"
                                Height="26"
                                Padding="0"
                                ToolTip="{DynamicResource Loc_Close}">
                            <Path Data="{StaticResource CloseIconGeometry}"
                                  Stroke="{DynamicResource ThemeTextPrimaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="9" Height="9"
                                  Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Translated text (scrollable so very long translations never overflow screen) -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="280"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TranslatedTextBlock"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               FontSize="14.5"
                               LineHeight="21"
                               FontWeight="Medium"
                               FontFamily="Segoe UI" />
                </ScrollViewer>

                <!-- Original text snippet with Copy Original button -->
                <Border x:Name="SourceTextBorder"
                        Grid.Row="2"
                        Margin="0,10,0,0"
                        Padding="10,6"
                        CornerRadius="10"
                        Background="{DynamicResource ThemeCardBgBrush}"
                        BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                        BorderThickness="1">
                    <DockPanel>
                        <Button x:Name="CopySourceButton"
                                DockPanel.Dock="Right"
                                Content="{DynamicResource Loc_CopyOriginal}"
                                Click="OnCopySourceClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Padding="8,3"
                                Margin="8,0,0,0"
                                FontSize="10.5"
                                VerticalAlignment="Top" />
                        <TextBlock x:Name="SourceTextBlock"
                                   TextWrapping="Wrap"
                                   MaxHeight="64"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   FontSize="11.5"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
