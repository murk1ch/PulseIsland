<Window x:Class="PulseIsland.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        DragEnter="OnIslandDragEnter"
        DragOver="OnIslandDragEnter"
        DragLeave="OnIslandDragLeave"
        Drop="OnIslandDrop"
        Width="580"
        Height="820">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Crisp Vector Geometries (Zero Emojis) -->
        <Geometry x:Key="PrevIconGeometry">M 0,1 L 1.8,1 L 1.8,10 L 0,10 Z M 9,0.8 L 2.6,5.5 L 9,10.2 Z</Geometry>
        <Geometry x:Key="PlayIconGeometry">M 1.5,0.5 L 10,5.5 L 1.5,10.5 Z</Geometry>
        <Geometry x:Key="PauseIconGeometry">M 1,0.8 L 3.6,0.8 L 3.6,10.2 L 1,10.2 Z M 6.2,0.8 L 8.8,0.8 L 8.8,10.2 L 6.2,10.2 Z</Geometry>
        <Geometry x:Key="NextIconGeometry">M 0,0.8 L 6.4,5.5 L 0,10.2 Z M 7.2,1 L 9,1 L 9,10 L 7.2,10 Z</Geometry>
        <Geometry x:Key="MusicNoteGeometry">M 3.8,10.8 A 2.1,1.7 0 1 1 3.8,7.4 A 2.1,1.7 0 1 1 3.8,10.8 Z M 10.2,9.2 A 2.1,1.7 0 1 1 10.2,5.8 A 2.1,1.7 0 1 1 10.2,9.2 Z M 5.2,8.8 L 5.2,2.2 L 11.6,0.8 L 11.6,7.4 L 10.1,7.7 L 10.1,2.9 L 6.7,3.7 L 6.7,8.8 Z</Geometry>
        <Geometry x:Key="ScanIconGeometry">M 1,3.8 L 1,1 L 3.8,1 M 8.2,1 L 11,1 L 11,3.8 M 11,8.2 L 11,11 L 8.2,11 M 3.8,11 L 1,11 L 1,8.2 M 3.5,6 L 8.5,6 M 6,3.5 L 6,8.5</Geometry>
        <Geometry x:Key="ClipboardIconGeometry">M 4,1.5 L 8,1.5 L 8,3 L 4,3 Z M 2.5,2.2 L 2.5,11 L 9.5,11 L 9.5,2.2 L 8,2.2 M 2.5,2.2 L 4,2.2 M 4.2,5.5 L 7.8,5.5 M 4.2,8 L 7.8,8</Geometry>
        <Geometry x:Key="SpeakerIconGeometry">M 1,4.2 L 3.4,4.2 L 6.5,1.5 L 6.5,10.5 L 3.4,7.8 L 1,7.8 Z M 8.5,3.8 A 3,3 0 0 1 8.5,8.2 M 10.2,2.2 A 5,5 0 0 1 10.2,9.8</Geometry>
        <Geometry x:Key="MicIconGeometry">M 4.5,1 A 1.5,1.5 0 0 1 7.5,1 L 7.5,5.5 A 1.5,1.5 0 0 1 4.5,5.5 Z M 2.5,5 A 3.5,3.5 0 0 0 9.5,5 M 6,8.5 L 6,11 M 4,11 L 8,11</Geometry>
        <Geometry x:Key="MicMutedIconGeometry">M 4.5,1 A 1.5,1.5 0 0 1 7.5,1 L 7.5,5.5 A 1.5,1.5 0 0 1 4.5,5.5 Z M 2.5,5 A 3.5,3.5 0 0 0 9.5,5 M 6,8.5 L 6,11 M 4,11 L 8,11 M 1.5,1.5 L 10.5,10.5</Geometry>
        <Geometry x:Key="AudioSwitchIconGeometry">M 2,3.5 L 9.5,3.5 M 7.2,1.5 L 9.5,3.5 L 7.2,5.5 M 10,8.5 L 2.5,8.5 M 4.8,6.5 L 2.5,8.5 L 4.8,10.5</Geometry>
        <Geometry x:Key="SearchIconGeometry">M 5,1.5 A 3.5,3.5 0 1 1 4.99,1.5 Z M 7.6,7.6 L 10.6,10.6</Geometry>
        <Geometry x:Key="SparkleMiniGeometry">M 6,1 L 7.2,4.8 L 11,6 L 7.2,7.2 L 6,11 L 4.8,7.2 L 1,6 L 4.8,4.8 Z</Geometry>
        <Geometry x:Key="FileIconGeometry">M 2,1 L 7,1 L 10,4 L 10,11 L 2,11 Z M 7,1 L 7,4 L 10,4</Geometry>
        <Geometry x:Key="SlidersIconGeometry">M 1,2.5 L 11,2.5 M 1,6 L 11,6 M 1,9.5 L 11,9.5 M 4,1 A 1.5,1.5 0 1 1 4,4 A 1.5,1.5 0 1 1 4,1 Z M 8,4.5 A 1.5,1.5 0 1 1 8,7.5 A 1.5,1.5 0 1 1 8,4.5 Z M 5,8 A 1.5,1.5 0 1 1 5,11 A 1.5,1.5 0 1 1 5,8 Z</Geometry>
        <Geometry x:Key="ChevronDownGeometry">M 1.5,3.5 L 5.5,7.5 L 9.5,3.5</Geometry>
        <Geometry x:Key="ChevronUpGeometry">M 1.5,7.5 L 5.5,3.5 L 9.5,7.5</Geometry>
        <Geometry x:Key="LightningBoltGeometry">M 6.5,0.5 L 1.2,6.8 L 5.0,6.8 L 3.8,11.5 L 10.2,5.0 L 6.2,5.0 Z</Geometry>

        <!-- Slim Dark Glass ScrollBar for Translation History -->
        <Style x:Key="IslandScrollThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource ThemeScrollThumbBrush}"
                                CornerRadius="3"
                                Margin="2,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="7" />
            <Setter Property="MinWidth" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Background="{DynamicResource ThemeScrollTrackBrush}" CornerRadius="3.5" Margin="1.5,2" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource IslandScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Refined Frosted Glass Pill Button -->
        <Style x:Key="IconPillButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeButtonHoverBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeButtonPressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Bold Section Mini-Pill Button ("Свернуть", "Очистить", Mic/Speaker Mute) -->
        <Style x:Key="MiniSectionPillButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MiniPillBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiniPillBd" Property="Background" Value="{DynamicResource ThemeButtonHoverBgBrush}" />
                                <Setter TargetName="MiniPillBd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MiniPillBd" Property="Background" Value="{DynamicResource ThemeButtonPressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Transport Control Button (on the compact island itself) -->
        <Style x:Key="CompactMediaButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MiniBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiniBd" Property="Background" Value="{DynamicResource ThemeButtonHoverBgBrush}" />
                                <Setter TargetName="MiniBd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MiniBd" Property="Background" Value="{DynamicResource ThemeButtonPressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Top-edge hover trigger zone so hidden island pops back out on mouse hover -->
        <Border x:Name="TopHoverTrigger"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="260"
                Height="8"
                Background="#01000000"
                MouseEnter="OnTopTriggerMouseEnter" />

        <!-- Island Container with Soft Ambient Shadow + Frosted Obsidian Glass Body -->
        <Grid x:Name="IslandWrapper"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,4,0,0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="IslandTranslate" Y="4" />
            </Grid.RenderTransform>

            <!-- Soft Dark Ambient Shadow + Subtle Album Tint (No Harsh Neon Rim) -->
            <Border x:Name="OuterNeonAuraBorder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="378"
                    Height="44"
                    CornerRadius="22"
                    Opacity="0.42"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="AuraPrimaryStop" Color="#FF05060A" Offset="0.0" />
                        <GradientStop x:Name="AuraMiddleStop" Color="#FF0A0D16" Offset="0.5" />
                        <GradientStop x:Name="AuraSecondaryStop" Color="#FF05060A" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="16" />
                </Border.Effect>
            </Border>

            <!-- Main Dynamic Island Frosted Glass Pill -->
            <Border x:Name="IslandPill"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="376"
                    Height="42"
                    CornerRadius="21"
                    BorderThickness="1"
                    Background="#01000000"
                    ClipToBounds="True"
                    Cursor="Hand"
                    BorderBrush="{DynamicResource ThemeGlassBorderBrush}"
                    MouseEnter="OnIslandMouseEnter"
                    MouseLeave="OnIslandMouseLeave"
                    MouseLeftButtonUp="OnIslandMouseLeftButtonUp">

                <Grid>
                    <!-- Controllable Theme Surface Layer (supports custom opacity slider in settings) -->
                    <Border x:Name="IslandBackgroundLayer"
                            Background="{DynamicResource ThemeSurfaceBrush}"
                            CornerRadius="{Binding CornerRadius, ElementName=IslandPill}"
                            IsHitTestVisible="False" />

                    <!-- Subtle Inner Glass Highlight -->
                    <Border CornerRadius="20"
                            Margin="1"
                            BorderThickness="1"
                            Opacity="0.18"
                            IsHitTestVisible="False">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="InnerGlowStop" Color="#44FFFFFF" Offset="0.0" />
                                <GradientStop Color="#00FFFFFF" Offset="0.7" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                    </Border>

                    <!-- Top Specular Glass Reflection -->
                    <Border Height="14"
                            VerticalAlignment="Top"
                            Margin="14,1,14,0"
                            CornerRadius="10,10,4,4"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#22FFFFFF" Offset="0.0" />
                                <GradientStop Color="#05FFFFFF" Offset="0.7" />
                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- COMPACT VIEW (with Blur-in / Blur-out Morphing) -->
                    <Grid x:Name="CompactContent"
                          Margin="10,0,10,0"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="CompactScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                        </Grid.RenderTransform>
                        <Grid.Effect>
                            <BlurEffect x:Name="CompactBlurEffect" Radius="0" />
                        </Grid.Effect>

                        <Grid VerticalAlignment="Center">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactNotificationActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsVolumeHudActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAiGenerating}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Album Art or Vector Music Icon -->
                            <Border x:Name="CompactCoverBorder"
                                    Grid.Column="0"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="8"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ThemeCardBgBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <Grid>
                                    <Path Data="{StaticResource MusicNoteGeometry}"
                                          Fill="{DynamicResource ThemeSectionHeaderBrush}"
                                          Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <Image x:Name="CompactCoverImage"
                                           Width="24"
                                           Height="24"
                                           Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,24,24" RadiusX="7" RadiusY="7" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <!-- Center-Left: Track Title / Marquee (Bold typography) -->
                            <Canvas x:Name="MarqueeClipCanvas"
                                    Grid.Column="1"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center"
                                    Height="20"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="CompactTrackText"
                                           Text="{Binding CompactHeaderText}"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           FontFamily="Segoe UI"
                                           Canvas.Top="1">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="MarqueeTransform" X="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>

                            <!-- Live Activity: Active Microphone Capture Pill (1-click Mute/Unmute right on Compact Island) -->
                            <Button x:Name="CompactActiveMicButton"
                                    Grid.Column="2"
                                    Visibility="{Binding ShowCompactActiveMicPill, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding CompactMicTooltip}"
                                    Click="OnToggleMicMuteClick"
                                    Style="{StaticResource MiniSectionPillButtonStyle}"
                                    Padding="7,3"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FF10B981" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                                        <Setter Property="Fill" Value="#FFEF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Path Width="10" Height="10"
                                          Stretch="Uniform"
                                          StrokeThickness="1.35"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource MicIconGeometry}" />
                                                <Setter Property="Stroke" Value="#FF34D399" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource MicMutedIconGeometry}" />
                                                        <Setter Property="Stroke" Value="#FFF87171" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </StackPanel>
                            </Button>

                            <!-- Center: Wireless Mouse Battery (shown in Compact when Music is inactive) -->
                            <Border x:Name="CompactMouseBatteryPill"
                                    Grid.Column="3"
                                    Visibility="{Binding ShowCompactMouseBattery, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding MouseBatteryTooltip}"
                                    Background="{DynamicResource ThemeCardBgBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="6,2"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="CompactMouseBolt"
                                          Data="{StaticResource LightningBoltGeometry}"
                                          Width="9" Height="11"
                                          Stretch="Uniform"
                                          Margin="0,0,3,0"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{DynamicResource ThemeAccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseCharging}" Value="True">
                                                        <Setter Property="Fill" Value="#FF34D399" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseBatteryLow}" Value="True">
                                                        <Setter Property="Fill" Value="#FFF87171" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding MouseBatteryText}"
                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               FontFamily="Segoe UI"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Center-Right: Live 60 FPS Symmetric Dynamic Island Audio Wave -->
                            <Canvas x:Name="CompactWaveCanvas"
                                    Grid.Column="4"
                                    Width="82"
                                    Height="24"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    ClipToBounds="False" />

                            <!-- Right: Crisp Vector Media Controls on the Compact Island (Prev / Play-Pause / Next) -->
                            <StackPanel Grid.Column="5"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button ToolTip="{DynamicResource Loc_Island_PrevTrack}"
                                        Click="OnPrevTrackClick"
                                        Style="{StaticResource CompactMediaButtonStyle}"
                                        Margin="0,0,3,0">
                                    <Path Data="{StaticResource PrevIconGeometry}"
                                          Fill="{DynamicResource ThemeTextPrimaryBrush}"
                                          Width="9" Height="9"
                                          Stretch="Uniform" />
                                </Button>

                                <Button ToolTip="{DynamicResource Loc_Island_PlayPause}"
                                        Click="OnPlayPauseClick"
                                        Style="{StaticResource CompactMediaButtonStyle}"
                                        Margin="0,0,3,0">
                                    <Path Fill="{DynamicResource ThemeTextPrimaryBrush}"
                                          Width="9" Height="9"
                                          Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource PlayIconGeometry}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource PauseIconGeometry}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>

                                <Button ToolTip="{DynamicResource Loc_Island_NextTrack}"
                                        Click="OnNextTrackClick"
                                        Style="{StaticResource CompactMediaButtonStyle}">
                                    <Path Data="{StaticResource NextIconGeometry}"
                                          Fill="{DynamicResource ThemeTextPrimaryBrush}"
                                          Width="9" Height="9"
                                          Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Transient Volume / Mic HUD Overlay inside Compact Pill -->
                        <Border x:Name="CompactVolumeHud"
                                Visibility="{Binding IsVolumeHudActive, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource ThemePopupBgBrush}"
                                CornerRadius="14"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding VolumeHudTitle}"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Height="6"
                                        CornerRadius="3"
                                        Background="{DynamicResource ThemeCardBgBrush}"
                                        VerticalAlignment="Center">
                                    <Border x:Name="CompactVolumeFill"
                                            HorizontalAlignment="Left"
                                            CornerRadius="3"
                                            Background="{DynamicResource ThemeAccentGradientBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Transient Notification Toast HUD inside Compact Pill -->
                        <Border x:Name="CompactNotificationHud"
                                Visibility="{Binding IsCompactNotificationActive, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource ThemePopupBgBrush}"
                                BorderBrush="{DynamicResource ThemeAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="8,3,6,3"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                ToolTip="{DynamicResource Loc_Island_ExpandNotifTooltip}"
                                MouseLeftButtonUp="OnCompactNotificationClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- App / Kind Pill Badge -->
                                <Border Grid.Column="0"
                                        Background="{DynamicResource ThemeHighlightBrush}"
                                        CornerRadius="10"
                                        Padding="7,3"
                                        Margin="0,0,9,0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{DynamicResource ThemeAccentBrush}"
                                                 Margin="0,0,5,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ActiveNotification.AppName}"
                                                   Foreground="{DynamicResource ThemeAccentBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="10.5"
                                                   MaxWidth="95"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Title and Body Snippet (clickable to open chat/app directly) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ActiveNotification.Title}"
                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Border Visibility="{Binding HasActiveNotificationTag, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource ThemeHighlightBrush}"
                                                CornerRadius="6"
                                                Padding="5,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActiveNotification.ContentTag}"
                                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                                       FontSize="9"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActiveNotification.Body}"
                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                </StackPanel>

                                <!-- Dismiss Button (✕) -->
                                <Button Grid.Column="2"
                                        Click="OnDismissNotificationClick"
                                        Style="{StaticResource IconPillButtonStyle}"
                                        Width="22" Height="22"
                                        VerticalAlignment="Center"
                                        ToolTip="{DynamicResource Loc_Island_DismissNotif}">
                                    <Path Data="M 2,2 L 8,8 M 8,2 L 2,8"
                                          Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="7" Height="7"
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Transient AI Thinking / Streaming HUD inside Compact Pill -->
                        <Border x:Name="CompactAiThinkingHud"
                                Background="{DynamicResource ThemePopupBgBrush}"
                                BorderBrush="{DynamicResource ThemeAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,4"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAiGenerating}" Value="True" />
                                                <Condition Binding="{Binding IsCompactNotificationActive}" Value="False" />
                                                <Condition Binding="{Binding IsVolumeHudActive}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Rectangle x:Name="AiCompactDot1" Width="4" Height="12" RadiusX="2" RadiusY="2" Fill="{DynamicResource ThemeAccentBrush}" Margin="0,0,3,0" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="AiDot1Scale" ScaleY="0.6" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle x:Name="AiCompactDot2" Width="4" Height="14" RadiusX="2" RadiusY="2" Fill="{DynamicResource ThemeAccentSecondaryBrush}" Margin="0,0,3,0" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="AiDot2Scale" ScaleY="1.0" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle x:Name="AiCompactDot3" Width="4" Height="12" RadiusX="2" RadiusY="2" Fill="{DynamicResource ThemeAccentBrush}" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform><ScaleTransform x:Name="AiDot3Scale" ScaleY="0.6" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding AiBackendBadge}"
                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                                <TextBlock Text="{Binding AiStatusLine}"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- EXPANDED VIEW (with Blur-in / Blur-out Materialization Morphing) -->
                    <Grid x:Name="ExpandedContent"
                          Margin="18,14,18,16"
                          Visibility="Collapsed"
                          Opacity="0"
                          RenderTransformOrigin="0.5,0.0">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ExpandedScaleTransform" ScaleX="0.92" ScaleY="0.92" />
                        </Grid.RenderTransform>
                        <Grid.Effect>
                            <BlurEffect x:Name="ExpandedBlurEffect" Radius="8" />
                        </Grid.Effect>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Bar: Title, Quick Translate, Smart Clipboard, Settings, Collapse, Hide -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" Background="{DynamicResource ThemeAccentBrush}" />
                                <TextBlock Text="PulseIsland"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           FontFamily="Segoe UI" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SmartClipboardButton"
                                        ToolTip="{DynamicResource Loc_Island_SmartClipTooltip}"
                                        Visibility="{Binding IsSmartClipboardEnabled, Converter={StaticResource BoolToVis}}"
                                        Click="OnOpenSmartClipboardClick"
                                        Style="{StaticResource IconPillButtonStyle}"
                                        Padding="10,5"
                                        Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource ClipboardIconGeometry}"
                                              Stroke="{DynamicResource ThemeAccentBrush}"
                                              StrokeThickness="1.4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Width="11" Height="11"
                                              Stretch="Uniform"
                                              Margin="0,0,5,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Loc_Island_ClipboardBtn}"
                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Strictly visible ONLY in Expanded state -->
                                <Button x:Name="SettingsButton"
                                        ToolTip="{DynamicResource Loc_Island_Settings}"
                                        Visibility="{Binding IsSettingsButtonVisible, Converter={StaticResource BoolToVis}}"
                                        Click="OnSettingsClick"
                                        Style="{StaticResource IconPillButtonStyle}"
                                        Width="30"
                                        Height="28"
                                        Margin="0,0,6,0">
                                    <Path Data="{StaticResource SlidersIconGeometry}"
                                          Stroke="{DynamicResource ThemeTextPrimaryBrush}"
                                          StrokeThickness="1.35"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="13" Height="13"
                                          Stretch="Uniform" />
                                </Button>

                                <Button ToolTip="{DynamicResource Loc_Island_CollapseToCompact}"
                                        Click="OnCollapseToCompactClick"
                                        Style="{StaticResource IconPillButtonStyle}"
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,6,0">
                                    <Path Data="{StaticResource ChevronDownGeometry}"
                                          Stroke="{DynamicResource ThemeTextPrimaryBrush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="10" Height="10"
                                          Stretch="Uniform" />
                                </Button>

                                <Button ToolTip="{DynamicResource Loc_Island_HideToTop}"
                                        Click="OnHideIslandClick"
                                        Style="{StaticResource IconPillButtonStyle}"
                                        Width="28"
                                        Height="28">
                                    <Path Data="{StaticResource ChevronUpGeometry}"
                                          Stroke="{DynamicResource ThemeTextPrimaryBrush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="10" Height="10"
                                          Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="1">
                            <!-- System Telemetry / Widget Badges + Wireless Mouse Battery -->
                            <DockPanel LastChildFill="True">
                                <Border x:Name="ExpandedMouseBatteryPill"
                                        DockPanel.Dock="Left"
                                        Visibility="{Binding IsMouseBatteryEnabled, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{Binding MouseBatteryTooltip}"
                                        Background="{DynamicResource ThemeControlBgBrush}"
                                        BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="9,4"
                                        Margin="0,0,6,6"
                                        VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path x:Name="ExpandedMouseBolt"
                                              Data="{StaticResource LightningBoltGeometry}"
                                              Width="9" Height="11"
                                              Stretch="Uniform"
                                              Margin="0,0,4,0"
                                              VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="{DynamicResource ThemeAccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseCharging}" Value="True">
                                                            <Setter Property="Fill" Value="#FF34D399" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMouseBatteryLow}" Value="True">
                                                            <Setter Property="Fill" Value="#FFF87171" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding MouseBatteryText}"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding SystemIndicatorBadges}"
                                              Visibility="{Binding HasSystemIndicators, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThemeControlBgBrush}"
                                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="9,4"
                                                    Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>

                            <!-- Status Banner -->
                            <Border Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource ThemeHighlightBrush}"
                                    BorderBrush="{DynamicResource ThemeAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,5"
                                    Margin="0,0,0,10">
                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           FontSize="11.5"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </StackPanel>

                        <!-- Collapsible Music & Visualizer Glass Card -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource ThemeCardBgBrush}"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,10"
                                Margin="0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{DynamicResource Loc_Island_MusicSection}"
                                               Foreground="{DynamicResource ThemeSectionHeaderBrush}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Click="OnToggleMusicSectionClick">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MiniSectionPillButtonStyle}">
                                                <Setter Property="Content" Value="{DynamicResource Loc_Collapse}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMusicSectionVisible}" Value="False">
                                                        <Setter Property="Content" Value="{DynamicResource Loc_Show}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Dedicated Live Audio Controls Row (never overlaps header title) -->
                                <WrapPanel Visibility="{Binding IsVolumeAndMicEnabled, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,0,8">
                                    <Button x:Name="AudioOutputSwitchBtn"
                                            Visibility="{Binding CanSwitchAudioOutput, Converter={StaticResource BoolToVis}}"
                                            Click="OnCycleAudioOutputClick"
                                            Style="{StaticResource MiniSectionPillButtonStyle}"
                                            Margin="0,0,6,4"
                                            ToolTip="{Binding AudioOutputTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource AudioSwitchIconGeometry}"
                                                  Stroke="{DynamicResource ThemeAccentBrush}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="10" Height="10" Stretch="Uniform"
                                                  Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AudioOutputShortLabel}"
                                                       MaxWidth="140"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SpeakerMuteBtn"
                                            Click="OnToggleSpeakerMuteClick"
                                            Style="{StaticResource MiniSectionPillButtonStyle}"
                                            Margin="0,0,6,4"
                                            ToolTip="{DynamicResource Loc_Island_ToggleSpeaker}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource SpeakerIconGeometry}"
                                                  Stroke="{DynamicResource ThemeAccentBrush}"
                                                  StrokeThickness="1.35"
                                                  Width="10" Height="10" Stretch="Uniform"
                                                  Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SpeakerLabel}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="MicMuteBtn"
                                            Click="OnToggleMicMuteClick"
                                            Style="{StaticResource MiniSectionPillButtonStyle}"
                                            Margin="0,0,0,4"
                                            ToolTip="{Binding CompactMicTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6"
                                                     Margin="0,0,4,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsMicActivelyCapturing, Converter={StaticResource BoolToVis}}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#FF10B981" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                                                <Setter Property="Fill" Value="#FFEF4444" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Path Width="10" Height="10" Stretch="Uniform"
                                                  StrokeThickness="1.35"
                                                  Margin="0,0,4,0" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource MicIconGeometry}" />
                                                        <Setter Property="Stroke" Value="{DynamicResource ThemeAccentSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource MicMutedIconGeometry}" />
                                                                <Setter Property="Stroke" Value="#FFF87171" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding MicLabel}"
                                                       MaxWidth="150"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <StackPanel x:Name="ExpandedMusicBody"
                                            Visibility="{Binding IsMusicSectionVisible, Converter={StaticResource BoolToVis}}"
                                            RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <ScaleTransform x:Name="MusicSectionScale" ScaleX="1" ScaleY="1" />
                                    </StackPanel.RenderTransform>
                                    <StackPanel.Effect>
                                        <BlurEffect x:Name="MusicSectionBlur" Radius="0" />
                                    </StackPanel.Effect>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover with Toggleable Adaptive Album Glow -->
                                        <Border x:Name="ExpandedCoverBorder"
                                                Grid.Column="0"
                                                Width="54"
                                                Height="54"
                                                CornerRadius="13"
                                                Background="{DynamicResource ThemeControlBgBrush}"
                                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,12,0"
                                                ClipToBounds="True">
                                            <Border.Effect>
                                                <DropShadowEffect x:Name="AlbumArtGlowEffect"
                                                                  Color="#FF38BDF8"
                                                                  BlurRadius="16"
                                                                  ShadowDepth="0"
                                                                  Opacity="0" />
                                            </Border.Effect>
                                            <Grid>
                                                <Path Data="{StaticResource MusicNoteGeometry}"
                                                      Fill="{DynamicResource ThemeSectionHeaderBrush}"
                                                      Width="20"
                                                      Height="20"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                                <Image x:Name="ExpandedCoverImage"
                                                       Width="52"
                                                       Height="52"
                                                       Stretch="UniformToFill">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,52,52" RadiusX="12" RadiusY="12" />
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>
                                        </Border>

                                        <!-- Bold Track info + 60 FPS Symmetric Bezier Wave -->
                                        <StackPanel x:Name="ExpandedTrackInfoPanel"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform x:Name="ExpandedTrackSlideTransform" Y="0" />
                                            </StackPanel.RenderTransform>
                                            <TextBlock Text="{Binding ExpandedTrackTitle}"
                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                       FontSize="14.5"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ExpandedTrackArtist}"
                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,5" />
                                            <Canvas x:Name="ExpandedWaveCanvas"
                                                    Height="24"
                                                    HorizontalAlignment="Stretch"
                                                    ClipToBounds="False" />
                                        </StackPanel>

                                        <!-- Rounded Vector Playback Controls -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button ToolTip="{DynamicResource Loc_Island_PrevTrack}"
                                                    Click="OnPrevTrackClick"
                                                    Style="{StaticResource IconPillButtonStyle}"
                                                    Width="34" Height="34" Margin="0,0,5,0">
                                                <Path Data="{StaticResource PrevIconGeometry}"
                                                      Fill="{DynamicResource ThemeTextPrimaryBrush}"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform" />
                                            </Button>

                                            <Button ToolTip="{DynamicResource Loc_Island_PlayPause}"
                                                    Click="OnPlayPauseClick"
                                                    Style="{StaticResource IconPillButtonStyle}"
                                                    Width="38" Height="38" Margin="0,0,5,0">
                                                <Path Fill="{DynamicResource ThemeTextPrimaryBrush}"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Data" Value="{StaticResource PlayIconGeometry}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource PauseIconGeometry}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Button>

                                            <Button ToolTip="{DynamicResource Loc_Island_NextTrack}"
                                                    Click="OnNextTrackClick"
                                                    Style="{StaticResource IconPillButtonStyle}"
                                                    Width="34" Height="34">
                                                <Path Data="{StaticResource NextIconGeometry}"
                                                      Fill="{DynamicResource ThemeTextPrimaryBrush}"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Toggleable Interactive Track Seek Progress Bar -->
                                    <Grid x:Name="TrackProgressRow"
                                          Visibility="{Binding IsProgressBarVisible, Converter={StaticResource BoolToVis}}"
                                          Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TrackPositionText}"
                                                   Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <Grid x:Name="TrackSeekBarContainer"
                                              Grid.Column="1"
                                              Height="14"
                                              Background="Transparent"
                                              Cursor="Hand"
                                              MouseLeftButtonDown="OnTrackProgressSeekClick">
                                            <Border Height="5"
                                                    CornerRadius="2.5"
                                                    Background="{DynamicResource ThemeControlBgBrush}"
                                                    VerticalAlignment="Center" />
                                            <Border x:Name="TrackProgressFill"
                                                    Height="5"
                                                    HorizontalAlignment="Left"
                                                    Width="0"
                                                    CornerRadius="2.5"
                                                    Background="{DynamicResource ThemeAccentGradientBrush}"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TrackDurationText}"
                                                   Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Collapsible Translation History Glass Card -->
                        <Border Grid.Row="3"
                                Margin="0,10,0,0"
                                Background="{DynamicResource ThemeCardBgBrush}"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{DynamicResource Loc_Island_TranslatorSection}"
                                               Foreground="{DynamicResource ThemeSectionHeaderBrush}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource Loc_Clear}"
                                                Click="OnClearHistoryClick"
                                                Style="{StaticResource MiniSectionPillButtonStyle}"
                                                Margin="0,0,6,0" />
                                        <Button Click="OnToggleTranslationSectionClick">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MiniSectionPillButtonStyle}">
                                                    <Setter Property="Content" Value="{DynamicResource Loc_Collapse}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTranslationSectionVisible}" Value="False">
                                                            <Setter Property="Content" Value="{DynamicResource Loc_Show}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>

                                <Grid x:Name="ExpandedTranslationBody"
                                      Grid.Row="1"
                                      Margin="0,8,0,0"
                                      ClipToBounds="True"
                                      Visibility="{Binding IsTranslationSectionVisible, Converter={StaticResource BoolToVis}}"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="TranslationSectionScale" ScaleX="1" ScaleY="1" />
                                    </Grid.RenderTransform>
                                    <Grid.Effect>
                                        <BlurEffect x:Name="TranslationSectionBlur" Radius="0" />
                                    </Grid.Effect>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Live Search Box inside Translation History -->
                                    <Border Grid.Row="0"
                                            Visibility="{Binding HasTranslationHistory, Converter={StaticResource BoolToVis}}"
                                            Background="{DynamicResource ThemeControlBgBrush}"
                                            BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8,4"
                                            Margin="0,0,0,7"
                                            Cursor="IBeam"
                                            PreviewMouseLeftButtonDown="OnTranslationSearchMouseDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Data="{StaticResource SearchIconGeometry}"
                                                  Stroke="{DynamicResource ThemeTextMutedBrush}"
                                                  StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{DynamicResource Loc_Island_TransSearchPlaceholder}"
                                                       Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTranslationSearchQuery}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ElementName=TranslationSearchBox, Path=IsKeyboardFocused}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="TranslationSearchBox"
                                                     Grid.Column="1"
                                                     Text="{Binding TranslationSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                     CaretBrush="{DynamicResource ThemeAccentBrush}"
                                                     FontSize="11.5"
                                                     VerticalContentAlignment="Center"
                                                     PreviewMouseLeftButtonDown="OnTranslationSearchMouseDown"
                                                     LostKeyboardFocus="OnTranslationSearchLostFocus"
                                                     KeyDown="OnTranslationSearchKeyDown" />
                                            <Button Grid.Column="2"
                                                    Visibility="{Binding HasTranslationSearchQuery, Converter={StaticResource BoolToVis}}"
                                                    Click="OnClearTranslationSearchClick"
                                                    Style="{StaticResource MiniSectionPillButtonStyle}"
                                                    Padding="6,1"
                                                    Margin="4,0,0,0"
                                                    ToolTip="{DynamicResource Loc_Island_ResetSearch}">
                                                <Path Data="M 2,2 L 8,8 M 8,2 L 2,8"
                                                      Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                                                      StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Width="7" Height="7"
                                                      Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="1"
                                               Text="{DynamicResource Loc_Island_TransSearchEmpty}"
                                               Visibility="{Binding ShowEmptyTranslationSearchHint, Converter={StaticResource BoolToVis}}"
                                               Foreground="{DynamicResource ThemeTextMutedBrush}"
                                               FontSize="11"
                                               Margin="2,0,0,4" />

                                    <ScrollViewer Grid.Row="2"
                                                  MaxHeight="155"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FilteredTranslationHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ThemeControlBgBrush}"
                                                            BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="10,7"
                                                            Margin="0,0,0,6"
                                                            Cursor="Hand"
                                                            ToolTip="{DynamicResource Loc_Island_ExpandTranslationTooltip}"
                                                            MouseLeftButtonUp="OnHistoryItemToggleClick">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Margin="8,0,0,0">
                                                                <Button Content="{DynamicResource Loc_Original}"
                                                                        Tag="{Binding SourceText}"
                                                                        Click="OnCopyHistoryItemClick"
                                                                        Style="{StaticResource MiniSectionPillButtonStyle}"
                                                                        Padding="8,4"
                                                                        Margin="0,0,5,0"
                                                                        ToolTip="{DynamicResource Loc_Island_CopyOriginalTooltip}" />
                                                                <Button Content="{DynamicResource Loc_Copy}"
                                                                        Tag="{Binding TranslatedText}"
                                                                        Click="OnCopyHistoryItemClick"
                                                                        Style="{StaticResource MiniSectionPillButtonStyle}"
                                                                        Padding="10,4"
                                                                        ToolTip="{DynamicResource Loc_Island_CopyTranslationTooltip}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock x:Name="HistoryTranslatedText"
                                                                           DataContextChanged="OnHistoryItemTextDataContextChanged"
                                                                           Loaded="OnHistoryItemTextLoaded"
                                                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap" />
                                                                <TextBlock x:Name="HistorySourceText"
                                                                           DataContextChanged="OnHistorySourceTextDataContextChanged"
                                                                           Loaded="OnHistorySourceTextLoaded"
                                                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                                           FontSize="10.5"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ══════════════ NOTIFICATIONS CARD ══════════════ -->
                        <Border x:Name="NotificationCard"
                                Grid.Row="4"
                                Margin="0,10,0,0"
                                Visibility="{Binding IsNotificationsEnabled, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource ThemeCardBgBrush}"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,10">
                            <StackPanel>
                                <!-- Section header -->
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 6,1 A 4,4 0 0 1 10,5 L 10,8.5 L 11.5,10.5 L 0.5,10.5 L 2,8.5 L 2,5 A 4,4 0 0 1 6,1 Z M 4.5,10.5 A 1.5,1.5 0 0 0 7.5,10.5"
                                              Stroke="{DynamicResource ThemeSectionHeaderBrush}"
                                              StrokeThickness="1.3"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="11" Height="11"
                                              Stretch="Uniform"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Loc_Island_NotificationsSection}"
                                                   Foreground="{DynamicResource ThemeSectionHeaderBrush}"
                                                   FontSize="10.5"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Border x:Name="NotifCountBadge"
                                                Background="{DynamicResource ThemeAccentBrush}"
                                                CornerRadius="8"
                                                Padding="6,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasNotificationHistory, Converter={StaticResource BoolToVis}}">
                                            <TextBlock x:Name="NotifCountText"
                                                       Text="{Binding NotificationCountText}"
                                                       Foreground="{DynamicResource ThemeAccentTextBrush}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource Loc_Clear}"
                                                Click="OnClearNotificationsClick"
                                                Style="{StaticResource MiniSectionPillButtonStyle}"
                                                Visibility="{Binding HasNotificationHistory, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,6,0" />
                                        <Button Click="OnToggleNotificationHistoryClick">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MiniSectionPillButtonStyle}">
                                                    <Setter Property="Content" Value="{DynamicResource Loc_History}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNotificationHistoryVisible}" Value="True">
                                                            <Setter Property="Content" Value="{DynamicResource Loc_Hide}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Active notification banner -->
                                <Border x:Name="ActiveNotifBanner"
                                        Visibility="{Binding HasActiveNotification, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource ThemeControlBgBrush}"
                                        BorderBrush="{DynamicResource ThemeAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="12,10"
                                        Margin="0,0,0,8"
                                        Cursor="Hand"
                                        ToolTip="{DynamicResource Loc_Island_OpenNotifTooltip}"
                                        MouseLeftButtonUp="OnActiveNotificationClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Kind indicator pill -->
                                        <Border Grid.Column="0"
                                                Width="30" Height="30"
                                                CornerRadius="10"
                                                Background="{DynamicResource ThemeHighlightBrush}"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NotificationKindLabel}"
                                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="Bold" />
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock Text="{Binding ActiveNotification.AppName}"
                                                           DockPanel.Dock="Left"
                                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                                <Border Visibility="{Binding HasActiveNotificationTag, Converter={StaticResource BoolToVis}}"
                                                        DockPanel.Dock="Left"
                                                        Background="{DynamicResource ThemeHighlightBrush}"
                                                        CornerRadius="6"
                                                        Padding="6,1"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ActiveNotification.ContentTag}"
                                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                                               FontSize="9"
                                                               FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="{Binding ActiveNotification.TimeAgoText}"
                                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                           FontSize="9.5"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding ActiveNotification.Title}"
                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                       FontSize="12.5"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding ActiveNotification.Body}"
                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="48"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Dismiss button -->
                                        <Button Grid.Column="2"
                                                Click="OnDismissNotificationClick"
                                                Style="{StaticResource IconPillButtonStyle}"
                                                Width="22" Height="22"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Top"
                                                ToolTip="{DynamicResource Loc_Close}">
                                            <Path Data="M 2,2 L 8,8 M 8,2 L 2,8"
                                                  Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Width="8" Height="8"
                                                  Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Empty state hint -->
                                <TextBlock Text="{DynamicResource Loc_Island_NotifEmptyHint}"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasActiveNotification}" Value="False" />
                                                        <Condition Binding="{Binding HasNotificationHistory}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Collapsed history summary hint -->
                                <TextBlock Text="{DynamicResource Loc_Island_NotifHistoryHint}"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasActiveNotification}" Value="False" />
                                                        <Condition Binding="{Binding HasNotificationHistory}" Value="True" />
                                                        <Condition Binding="{Binding IsNotificationHistoryVisible}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Notification history list -->
                                <Grid x:Name="ExpandedNotificationHistoryBody"
                                      Visibility="{Binding IsNotificationHistoryVisible, Converter={StaticResource BoolToVis}}"
                                      Margin="0,4,0,0"
                                      ClipToBounds="True"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="NotificationHistoryScale" ScaleX="1" ScaleY="1" />
                                    </Grid.RenderTransform>
                                    <Grid.Effect>
                                        <BlurEffect x:Name="NotificationHistoryBlur" Radius="0" />
                                    </Grid.Effect>
                                    <ScrollViewer MaxHeight="200"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding NotificationHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ThemeControlBgBrush}"
                                                            BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="11"
                                                            Padding="10,7"
                                                            Margin="0,0,0,5"
                                                            Cursor="Hand"
                                                            ToolTip="{DynamicResource Loc_Island_OpenNotifTooltip}"
                                                            Tag="{Binding}"
                                                            MouseLeftButtonUp="OnHistoryNotificationClick">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding AppName}"
                                                                           DockPanel.Dock="Left"
                                                                           Foreground="{DynamicResource ThemeAccentBrush}"
                                                                           FontSize="9.5"
                                                                           FontWeight="Bold"
                                                                           Margin="0,0,6,0" />
                                                                <Border Visibility="{Binding HasContentTag, Converter={StaticResource BoolToVis}}"
                                                                        DockPanel.Dock="Left"
                                                                        Background="{DynamicResource ThemeHighlightBrush}"
                                                                        CornerRadius="5"
                                                                        Padding="5,0"
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ContentTag}"
                                                                               Foreground="{DynamicResource ThemeAccentBrush}"
                                                                               FontSize="8.5"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                                <TextBlock Text="{Binding TimeAgoText}"
                                                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                                           FontSize="9.5"
                                                                           HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding Body}"
                                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                       FontSize="10.5"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="36"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- File Drop Shelf Card (hidden until dragging files over island or dropped files exist) -->
                        <Border x:Name="FileDropZoneCard"
                                Grid.Row="5"
                                Margin="0,10,0,0"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,9"
                                Visibility="{Binding IsFileDropZoneVisible, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ThemeCardBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDragOverFileDropZone}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ThemeHighlightBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{DynamicResource Loc_Island_FileShelfSection}"
                                               Foreground="{DynamicResource ThemeSectionHeaderBrush}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            Content="{DynamicResource Loc_Clear}"
                                            Click="OnClearDroppedFilesClick"
                                            Visibility="{Binding HasDroppedFiles, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource MiniSectionPillButtonStyle}" />
                                </DockPanel>

                                <TextBlock x:Name="DropShelfEmptyHint"
                                           Text="{DynamicResource Loc_Island_FileShelfHint}"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />

                                <ItemsControl x:Name="DroppedFilesItemsControl"
                                              ItemsSource="{Binding DroppedFiles}"
                                              Visibility="{Binding HasDroppedFiles, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThemeButtonBgBrush}"
                                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="8,5"
                                                    Margin="0,0,6,5"
                                                    Cursor="Hand"
                                                    Tag="{Binding FilePath}"
                                                    ToolTip="{Binding FilePath}"
                                                    PreviewMouseLeftButtonDown="OnDropItemMouseDown"
                                                    PreviewMouseLeftButtonUp="OnDropItemMouseUp"
                                                    MouseMove="OnDropItemMouseMove">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource FileIconGeometry}"
                                                              Stroke="{DynamicResource ThemeAccentBrush}"
                                                              StrokeThickness="1.3"
                                                              Width="10" Height="11" Stretch="Uniform"
                                                              Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FileName}"
                                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   MaxWidth="145"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding SizeDisplay}"
                                                                   Foreground="{DynamicResource ThemeTextMutedBrush}"
                                                                   FontSize="10"
                                                                   Margin="5,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding IsImageFile, Converter={StaticResource BoolToVis}}"
                                                                Margin="0,5,0,0"
                                                                VerticalAlignment="Center">
                                                        <Button Tag="{Binding FilePath}"
                                                                Click="OnDropItemAskAiClick"
                                                                Style="{StaticResource MiniSectionPillButtonStyle}"
                                                                Padding="7,2"
                                                                FontSize="9.5"
                                                                Margin="0,0,4,0"
                                                                ToolTip="{DynamicResource Loc_Island_ShelfAskAiTooltip}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource SparkleMiniGeometry}"
                                                                      Fill="{DynamicResource ThemeAccentBrush}"
                                                                      Width="8" Height="8" Stretch="Uniform"
                                                                      Margin="0,0,3,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{DynamicResource Loc_AskAiShort}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Content="PNG"
                                                                Tag="{Binding FilePath}"
                                                                Visibility="{Binding CanConvertToPng, Converter={StaticResource BoolToVis}}"
                                                                Click="OnDropItemConvertPngClick"
                                                                Style="{StaticResource MiniSectionPillButtonStyle}"
                                                                Padding="7,2"
                                                                FontSize="9.5"
                                                                Margin="0,0,4,0"
                                                                ToolTip="{DynamicResource Loc_Island_ShelfPngTooltip}" />
                                                        <Button Content="JPG"
                                                                Tag="{Binding FilePath}"
                                                                Visibility="{Binding CanCompressToJpg, Converter={StaticResource BoolToVis}}"
                                                                Click="OnDropItemCompressJpgClick"
                                                                Style="{StaticResource MiniSectionPillButtonStyle}"
                                                                Padding="7,2"
                                                                FontSize="9.5"
                                                                ToolTip="{DynamicResource Loc_Island_ShelfJpgTooltip}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
