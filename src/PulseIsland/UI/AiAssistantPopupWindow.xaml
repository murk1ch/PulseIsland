<Window x:Class="PulseIsland.UI.AiAssistantPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Width="560"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Geometry x:Key="CloseIconGeometry">M 1,1 L 9,9 M 9,1 L 1,9</Geometry>
        <Geometry x:Key="AiStarGeometry">M 6,0.5 L 7.4,4.6 L 11.5,6 L 7.4,7.4 L 6,11.5 L 4.6,7.4 L 0.5,6 L 4.6,4.6 Z</Geometry>
        <Geometry x:Key="VoiceMicGeometry">M 4.5,1 A 1.5,1.5 0 0 1 7.5,1 L 7.5,5.5 A 1.5,1.5 0 0 1 4.5,5.5 Z M 2.5,5 A 3.5,3.5 0 0 0 9.5,5 M 6,8.5 L 6,11 M 4,11 L 8,11</Geometry>

        <!-- Slim Dark Glass ScrollBar matching PulseIsland UI -->
        <Style x:Key="AiPopupScrollThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{DynamicResource ThemeScrollThumbBrush}"
                                CornerRadius="3"
                                Margin="2,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="7" />
            <Setter Property="MinWidth" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Background="{DynamicResource ThemeScrollTrackBrush}" CornerRadius="3.5" Margin="1.5,2" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsHitTestVisible="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AiPopupScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsHitTestVisible="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeButtonBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeButtonHoverBgBrush}" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeButtonPressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootPopupContainer"
          Margin="16"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PopupScaleTransform" ScaleX="0.92" ScaleY="0.92" />
        </Grid.RenderTransform>
        <Grid.Effect>
            <BlurEffect x:Name="PopupBlurEffect" Radius="8" />
        </Grid.Effect>

        <!-- Ambient Shadow / Breathing AI Aura -->
        <Border x:Name="AmbientShadowBorder"
                CornerRadius="22"
                Margin="-2"
                Background="#70000000"
                IsHitTestVisible="False">
            <Border.Effect>
                <BlurEffect Radius="18" />
            </Border.Effect>
        </Border>

        <!-- Main Frosted Glass Widget (drag header/background to move) -->
        <Border x:Name="MainPopupCard"
                Padding="16,14"
                CornerRadius="20"
                BorderThickness="1"
                Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeGlassBorderBrush}"
                MouseLeftButtonDown="OnPopupMouseLeftButtonDown">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Specular Glass Reflection -->
                <Border Grid.Row="0"
                        Height="14"
                        VerticalAlignment="Top"
                        Margin="-10,-10,-10,0"
                        CornerRadius="16,16,0,0"
                        Background="{DynamicResource ThemeReflectionBrush}"
                        IsHitTestVisible="False" />

                <!-- Row 0: Header (2-row responsive Grid so badges & buttons NEVER clip or overlap) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                HorizontalAlignment="Left"
                                Padding="10,4"
                                CornerRadius="10"
                                Margin="0,0,8,0"
                                Background="{DynamicResource ThemeHighlightBrush}"
                                BorderBrush="{DynamicResource ThemeAccentBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource AiStarGeometry}"
                                      Fill="{DynamicResource ThemeAccentBrush}"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                                <TextBlock x:Name="ModelNameBadgeText"
                                           Text="Qwen 2.5 7B"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{DynamicResource Loc_Ai_NewChatBtn}"
                                    Click="OnClearClick"
                                    Style="{StaticResource GlassActionButtonStyle}"
                                    Padding="9,4"
                                    Margin="0,0,5,0"
                                    FontSize="11"
                                    ToolTip="{DynamicResource Loc_Ai_NewChatTooltip}" />
                            <Button x:Name="CopyButton"
                                    Content="{DynamicResource Loc_Copy}"
                                    Click="OnCopyClick"
                                    Style="{StaticResource GlassActionButtonStyle}"
                                    Padding="9,4"
                                    Margin="0,0,5,0"
                                    FontSize="11" />
                            <Button Click="OnCloseClick"
                                    Style="{StaticResource GlassActionButtonStyle}"
                                    Width="26"
                                    Height="26"
                                    Padding="0"
                                    ToolTip="{DynamicResource Loc_CloseEsc}">
                                <Path Data="{StaticResource CloseIconGeometry}"
                                      Stroke="{DynamicResource ThemeTextPrimaryBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="9" Height="9"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Border Padding="8,3"
                                CornerRadius="9"
                                Margin="0,0,6,0"
                                Background="{DynamicResource ThemeControlBgBrush}"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="BackendBadgeText"
                                       Text="{DynamicResource Loc_Auto}"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </Border>
                        <Border x:Name="ChatMemoryBadge"
                                Visibility="Collapsed"
                                Padding="7,3"
                                CornerRadius="9"
                                Background="{DynamicResource ThemeControlBgBrush}"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                ToolTip="{DynamicResource Loc_Ai_ChatBadgeTooltip}">
                            <TextBlock x:Name="ChatMemoryBadgeText"
                                       Text="{DynamicResource Loc_Ai_ChatBadgeDefault}"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Row 1: Quick Action Chips + Custom User Prompt Chips + Voice/Prompt Input -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{DynamicResource Loc_Ai_WeatherBtn}"
                                Click="OnWeatherClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Padding="10,4"
                                FontSize="11"
                                Margin="0,0,5,4" />
                        <Button Content="{DynamicResource Loc_Ai_SummarizeClipBtn}"
                                Click="OnSummarizeClipboardClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Padding="10,4"
                                FontSize="11"
                                Margin="0,0,5,4" />
                        <Button Content="{DynamicResource Loc_Ai_TranslateAiBtn}"
                                Click="OnTranslateClipboardClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Padding="10,4"
                                FontSize="11"
                                Margin="0,0,5,4" />
                        <ItemsControl x:Name="CustomPromptsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}"
                                            Tag="{Binding}"
                                            ToolTip="{Binding PromptTemplate}"
                                            Click="OnCustomPromptChipClick"
                                            Style="{StaticResource GlassActionButtonStyle}"
                                            Padding="10,4"
                                            FontSize="11"
                                            Margin="0,0,5,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{DynamicResource ThemeControlBgBrush}"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="11,7"
                                Margin="0,0,6,0">
                            <Grid>
                                <TextBox x:Name="PromptInputBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                         CaretBrush="{DynamicResource ThemeAccentBrush}"
                                         FontSize="12.5"
                                         AcceptsReturn="False"
                                         VerticalContentAlignment="Center"
                                         KeyDown="OnPromptKeyDown" />
                                <TextBlock x:Name="PromptPlaceholderText"
                                           Text="{DynamicResource Loc_Ai_PromptPlaceholder}"
                                           Foreground="{DynamicResource ThemeTextMutedBrush}"
                                           FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=PromptInputBox, Path=Text}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Offline Voice Dictation Button (Whisper.cpp) with Live Level Pulse -->
                        <Button x:Name="VoiceDictateButton"
                                Grid.Column="1"
                                Click="OnVoiceDictateClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Width="34"
                                Height="34"
                                Padding="0"
                                Margin="0,0,6,0"
                                ToolTip="{DynamicResource Loc_Ai_MicTooltip}">
                            <Grid>
                                <Ellipse x:Name="VoicePulseRing"
                                         Width="26" Height="26"
                                         Fill="#38EF4444"
                                         Visibility="Collapsed"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="VoicePulseScale" ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Path x:Name="VoiceMicIcon"
                                      Data="{StaticResource VoiceMicGeometry}"
                                      Stroke="{DynamicResource ThemeAccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="12" Height="13"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="AskButton"
                                Grid.Column="2"
                                Content="{DynamicResource Loc_Ai_AskBtn}"
                                Click="OnAskClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Padding="14,7"
                                FontSize="12" />
                        <Button x:Name="StopButton"
                                Grid.Column="2"
                                Content="{DynamicResource Loc_Ai_StopBtn}"
                                Visibility="Collapsed"
                                Click="OnStopClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Padding="14,7"
                                FontSize="12" />
                    </Grid>
                </StackPanel>

                <!-- Row 2: Shimmer Bar during Token Generation -->
                <Border x:Name="ThinkingBarTrack"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Height="3"
                        CornerRadius="1.5"
                        ClipToBounds="True"
                        Background="{DynamicResource ThemeControlBgBrush}"
                        Margin="0,0,0,8">
                    <Border x:Name="ThinkingShimmerBar"
                            Width="130"
                            HorizontalAlignment="Left"
                            CornerRadius="1.5"
                            Background="{DynamicResource ThemeAccentGradientBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ThinkingShimmerTransform" X="-130" />
                        </Border.RenderTransform>
                    </Border>
                </Border>

                <!-- Row 3: Framed Selectable Rich AI Answer Card (renders multi-turn chat, LaTeX math, Markdown & Tables) -->
                <Border Grid.Row="3"
                        Background="{DynamicResource ThemeCardBgBrush}"
                        BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="StatusLineText"
                                   Text="{DynamicResource Loc_Ai_Ready}"
                                   Foreground="{DynamicResource ThemeSectionHeaderBrush}"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6" />

                        <RichTextBox x:Name="AnswerRichTextBox"
                                     IsReadOnly="True"
                                     IsDocumentEnabled="True"
                                     MaxHeight="350"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,0,6,0"
                                     Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                     SelectionBrush="{DynamicResource ThemeAccentBrush}"
                                     FontSize="13.5"
                                     FontFamily="Segoe UI"
                                     Cursor="IBeam" />
                    </StackPanel>
                </Border>

                <!-- Row 4: Attached Screenshot / Photo Preview for Vision LLM Q&A -->
                <Border x:Name="AttachedImageBorder"
                        Grid.Row="4"
                        Visibility="Collapsed"
                        Margin="0,10,0,0"
                        Padding="9,8"
                        CornerRadius="12"
                        Background="{DynamicResource ThemeControlBgBrush}"
                        BorderBrush="{DynamicResource ThemeAccentBrush}"
                        BorderThickness="1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Click="OnClearImageClick"
                                Style="{StaticResource GlassActionButtonStyle}"
                                Width="22"
                                Height="22"
                                Padding="0"
                                VerticalAlignment="Top"
                                Margin="8,0,0,0"
                                ToolTip="{DynamicResource Loc_Ai_RemovePhotoTooltip}">
                            <Path Data="{StaticResource CloseIconGeometry}"
                                  Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="8" Height="8"
                                  Stretch="Uniform" />
                        </Button>

                        <Border DockPanel.Dock="Left"
                                Width="74"
                                Height="56"
                                CornerRadius="8"
                                Margin="0,0,10,0"
                                Background="#FF0B0E18"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="1">
                            <Image x:Name="AttachedImagePreview"
                                   Width="72"
                                   Height="54"
                                   Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,72,54" RadiusX="7" RadiusY="7" />
                                </Image.Clip>
                            </Image>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AttachedImageTitleText"
                                       Text="{DynamicResource Loc_Ai_ScreenPhoto}"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="AttachedImageHintText"
                                       Text="{DynamicResource Loc_Ai_VisionReadyHint}"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       FontSize="10.5"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,6" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Loc_Ai_WhatInPhotoBtn}"
                                        Click="OnDescribeImageClick"
                                        Style="{StaticResource GlassActionButtonStyle}"
                                        Padding="9,3"
                                        FontSize="10.5"
                                        Margin="0,0,5,4" />
                                <Button Content="{DynamicResource Loc_Ai_ExplainSolveBtn}"
                                        Click="OnExplainImageClick"
                                        Style="{StaticResource GlassActionButtonStyle}"
                                        Padding="9,3"
                                        FontSize="10.5"
                                        Margin="0,0,5,4" />
                                <Button Content="{DynamicResource Loc_Ai_ExtractTextBtn}"
                                        Click="OnOcrImageClick"
                                        Style="{StaticResource GlassActionButtonStyle}"
                                        Padding="9,3"
                                        FontSize="10.5"
                                        Margin="0,0,5,4" />
                                <Button Content="{DynamicResource Loc_Ai_TableExportBtn}"
                                        Click="OnExtractTableClick"
                                        Style="{StaticResource GlassActionButtonStyle}"
                                        Padding="9,3"
                                        FontSize="10.5"
                                        Margin="0,0,0,4"
                                        ToolTip="{DynamicResource Loc_Ai_TableExportTooltip}" />
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Row 5: Source Text Snippet with Copy Original & Clear Context -->
                <Border x:Name="SourceTextBorder"
                        Grid.Row="5"
                        Visibility="Collapsed"
                        Margin="0,10,0,0"
                        Padding="10,7"
                        CornerRadius="12"
                        Background="{DynamicResource ThemeControlBgBrush}"
                        BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SourceTextBlock"
                                   Grid.Column="0"
                                   TextWrapping="Wrap"
                                   MaxHeight="72"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="CopySourceButton"
                                    Content="{DynamicResource Loc_CopyOriginal}"
                                    Click="OnCopySourceClick"
                                    Style="{StaticResource GlassActionButtonStyle}"
                                    Padding="8,3"
                                    FontSize="10.5"
                                    Margin="0,0,4,0" />
                            <Button Click="OnClearContextClick"
                                    Style="{StaticResource GlassActionButtonStyle}"
                                    Width="22"
                                    Height="22"
                                    Padding="0"
                                    ToolTip="{DynamicResource Loc_Ai_RemoveContextTooltip}">
                                <Path Data="{StaticResource CloseIconGeometry}"
                                      Stroke="{DynamicResource ThemeTextSecondaryBrush}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="8" Height="8"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
