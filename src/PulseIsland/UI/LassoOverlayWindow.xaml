<Window x:Class="PulseIsland.UI.LassoOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#0502040A"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="None">
    <Grid>
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <!-- Real-time frosted selection bounding box preview while dragging -->
            <Border x:Name="SelectionPreviewBorder"
                    Visibility="Collapsed"
                    CornerRadius="10"
                    Background="#16FFFFFF"
                    BorderBrush="#88FFFFFF"
                    BorderThickness="1.2" />

            <Canvas x:Name="TrailCanvas" />

            <Polyline x:Name="LassoPolyline"
                      Stroke="#FFFFFFFF"
                      StrokeThickness="2.4"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Opacity="0.95">
                <Polyline.Effect>
                    <DropShadowEffect Color="#FFFFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.7" />
                </Polyline.Effect>
            </Polyline>

            <Ellipse x:Name="CursorDot"
                     Width="10"
                     Height="10"
                     Fill="#FFFFFFFF"
                     Stroke="#66FFFFFF"
                     StrokeThickness="1.5"
                     Visibility="Collapsed">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FFFFFFFF" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- Frosted Glass hint pill at top-center while capturing -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                Padding="18,8"
                CornerRadius="18"
                Background="{DynamicResource ThemePopupBgBrush}"
                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource ThemeAccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Loc_Lasso_Hint}"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontSize="12.5"
                           FontWeight="Medium"
                           FontFamily="Segoe UI" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
